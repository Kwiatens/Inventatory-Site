---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformInstallSelector from '../components/PlatformInstallSelector.astro';
import content from '../content/pages/download.json';
import { url } from '../lib/url';

const resolveHref = (href: string) => href.startsWith('http') ? href : url(href);
---
<BaseLayout title={content.metaTitle} description={content.metaDescription}>
  <div class="wrap">
    <header class="page-intro">
      <h1>{content.heading}</h1>
      <p class="lead">{content.lead}</p>
    </header>
    <PlatformInstallSelector id="download-platforms" />
    <div class="download-notes section">
      {content.notes.map(note => (
        <section>
          <h2>{note.heading}</h2>
          <p>{note.text}</p>
          <a href={resolveHref(note.link.href)}>{note.link.label}</a>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
<style>
  .download-notes { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); padding-top: var(--space-8); border-top: var(--border) solid var(--divider); }
  .download-notes h2 { font-size: var(--text-lead); margin-bottom: var(--space-4); }
  .download-notes a { display: inline-block; margin-top: var(--space-4); }
  @media (max-width: 48rem) { .download-notes { grid-template-columns: 1fr; gap: var(--space-8); } }
</style>
