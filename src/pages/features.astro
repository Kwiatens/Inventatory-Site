---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../content/pages/features.json';
import { url } from '../lib/url';
---
<BaseLayout title={content.metaTitle} description={content.metaDescription}>
  <div class="wrap">
    <header class="page-intro">
      <h1>{content.heading}</h1>
      <p class="lead">{content.lead}</p>
    </header>
    <p class="notice">{content.notice}</p>
    <div class="features">
      {content.features.map(feature => (
        <section class="feature-section">
          <div>
            <h2>{feature.title}</h2>
            <a href={url(feature.href)}>{content.readGuideText}</a>
          </div>
          <div>
            <p>{feature.text}</p>
            <ul>{feature.details.map(detail => <li>{detail}</li>)}</ul>
          </div>
        </section>
      ))}
    </div>
    <section class="section prose">
      <h2>{content.boundaries.heading}</h2>
      {content.boundaries.paragraphs.map(p => <p>{p}</p>)}
      <a href={url(content.boundaries.link.href)}>{content.boundaries.link.label}</a>
    </section>
  </div>
</BaseLayout>
<style>
  .features { margin-top: var(--space-12); }
  .feature-section { display: grid; grid-template-columns: 1fr 1.5fr; gap: var(--space-12); padding-block: var(--space-8); border-top: var(--border) solid var(--divider); }
  .feature-section h2 { font-size: var(--text-lead); margin-bottom: var(--space-4); }
  .feature-section ul { color: var(--secondary); margin-bottom: 0; }
  .prose h2 { margin-top: 0; }
  @media (max-width: 44rem) { .feature-section { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
