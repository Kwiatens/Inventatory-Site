---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Lifecycle from '../components/home/Lifecycle.astro';
import SystemSheet from '../components/home/SystemSheet.astro';
import Scanner from '../components/home/Scanner.astro';
import PlatformInstallSelector from '../components/PlatformInstallSelector.astro';
import { nextSteps } from '../data/home';
import { url } from '../lib/url';
---
<BaseLayout title="Every component, accounted for">
  <Hero />
  <Lifecycle />
  <SystemSheet />
  <Scanner />
  <div class="wrap">
    <PlatformInstallSelector id="homepage-download" />
    <nav class="next" aria-label="After installing">
      {nextSteps.map((step, i) => (
        <a href={url(step.href)}><span>{String(i + 1).padStart(2, '0')}</span>{step.label}<i aria-hidden="true">→</i></a>
      ))}
    </nav>
  </div>
</BaseLayout>
<style>
  .next { display: grid; grid-template-columns: repeat(3, 1fr); margin: calc(-1 * var(--space-12)) 0 var(--space-20); border: var(--border) solid var(--divider); }
  .next a { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4) var(--space-6); color: var(--secondary); font: var(--text-sm)/1.5 var(--font-mono); text-decoration: none; transition: background .2s, color .2s; }
  .next a + a { border-left: var(--border) solid var(--divider); }
  .next span { color: var(--muted); }
  .next i { margin-left: auto; font-style: normal; color: var(--accent); transition: transform .2s; }
  .next a:hover { background: var(--surface); color: var(--text); }
  .next a:hover i { transform: translateX(3px); }
  @media (max-width: 48rem) {
    .next { grid-template-columns: 1fr; }
    .next a + a { border-left: 0; border-top: var(--border) solid var(--divider); }
  }
</style>
