---
/**
 * The homepage. The pixel art is drawn on the lockup's grid. The Scan R1 and the racks are generated from
 * models (scripts/pixel-art), and the scanner's screens come from its firmware
 * (scripts/scan-r1-lcd).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Lockup from '../components/Lockup.astro';
import PixelSprite from '../components/concept/PixelSprite.astro';
import LcdPanel from '../components/concept/LcdPanel.astro';
import Film from '../components/concept/Film.astro';
import Keypad from '../components/concept/Keypad.astro';
import Scanner from '../components/home/Scanner.astro';
import PlatformInstallSelector from '../components/PlatformInstallSelector.astro';
import art from '../data/pixel-art.json';
import { hero } from '../data/home';
import { url } from '../lib/url';

---
<BaseLayout title="Every component, accounted for">
  <section class="hero" aria-label="Introduction">
    <div class="hero-bg" aria-hidden="true">
      <video class="hero-video" autoplay loop muted playsinline preload="auto" poster={url('/media/scan-r1-poster.png')}>
        <source src={url('/media/scan-r1-turntable.webm')} type="video/webm" />
      </video>
      <canvas class="hero-pixels"></canvas>
    </div>

    <div class="wrap hero-inner">
      <h1 class="word"><Lockup tone="flat" cursor animate typo label="Inventatory" /></h1>
      <div class="intro">
        <p class="claim">{hero.title.join(' ')}</p>
        <p class="summary">{hero.summary}</p>
        <div class="acts">
          <a class="press" href="#homepage-download">{hero.primary}</a>
          <a class="quiet go" href="#intake-film">{hero.secondary}</a>
        </div>
      </div>
    </div>

    <a class="hero-scroll" href="#intake-film" aria-label="Scroll down to workflow">
      <span class="scroll-tag">EXPLORE</span>
      <span class="scroll-chevron" aria-hidden="true"></span>
    </a>
  </section>

  <section id="intake-film" class="bench band" aria-label="What Inventatory does">
    <div class="wrap">
      <Film />
    </div>
  </section>

  <Scanner>
    <div slot="model" class="r1" data-r1>
      <PixelSprite data={art.scanner} class="r1-art" label="Inventatory Scan R1" />
      <div class="r1-face">
        <LcdPanel label="Scan R1 display, as rendered by its firmware" />
        <Keypad />
      </div>
    </div>
  </Scanner>
  <div class="wrap"><PlatformInstallSelector id="homepage-download" /></div>
</BaseLayout>

<script>
  import { playScanR1 } from '../lib/scan-player';
  import { pixelVideo } from '../lib/pixel-video';

  // Keys flash in the sprite's keypad (and on a face-on keypad, when there is one).
  const press = (root: Element, key: string) => {
    const caps = root.querySelectorAll(`.faces [data-tag="key-${CSS.escape(key)}"]`);
    const face = root.querySelector(`[data-key="${CSS.escape(key)}"]`);
    caps.forEach(el => el.classList.add('pressed')); face?.classList.add('pressed');
    setTimeout(() => { caps.forEach(el => el.classList.remove('pressed')); face?.classList.remove('pressed'); }, 260);
  };

  // ---------- Scan R1 section: the device and its face, in the bench's pick flow ----------
  const r1 = document.querySelector<HTMLElement>('[data-r1]');
  if (r1) playScanR1(r1, {
    scenes: ['boot', 'pick', 'pick'],
    still: ['pick', 4200],
    onEvent: (_, event) => { if (event.startsWith('key:')) press(r1, event.slice(4)); },
  });

  // ---------- Hero background video: 0.5s persistence check on visibility ----------
  const heroVideo = document.querySelector<HTMLVideoElement>('.hero-video');
  const heroPixels = document.querySelector<HTMLCanvasElement>('.hero-pixels');
  if (heroVideo && heroPixels) pixelVideo(heroVideo, heroPixels);
  if (heroVideo) {
    let heroTimer: ReturnType<typeof setTimeout> | null = null;
    new IntersectionObserver(([e]) => {
      if (heroTimer) clearTimeout(heroTimer);
      const inView = e.isIntersecting;
      heroTimer = setTimeout(() => {
        if (inView) {
          heroVideo.play().catch(() => {});
        } else {
          heroVideo.pause();
        }
      }, 500);
    }, { threshold: 0.1 }).observe(heroVideo);
  }

</script>

<style is:global>
  /* The page's column is the film's width at 3x, so everything lines up with it. */
  :root { --width: 72rem; }
  /* Switchable pixels in generated sprites: gone (no part), lit (just placed), pressed (key). */
  .pixel-sprite [data-tag].gone, .pixel-art [data-tag].gone { opacity: 0; }
  .pixel-sprite .faces [data-tag].lit, .pixel-art .faces [data-tag].lit { fill: var(--focus); }
  .pixel-sprite .faces [data-tag].pressed { fill: var(--accent); }
</style>

<style>
  /* ---------- hero: full-screen video background ---------- */
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    margin-top: calc(-1 * var(--header-height));
    padding-top: calc(var(--header-height) + var(--space-8));
    padding-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    overflow: hidden;
    box-sizing: border-box;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* The video is the source; the canvas shows it on the art grid (lib/pixel-video). */
  .hero-video {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .hero-pixels {
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-block: auto;
    padding-block: var(--space-4);
  }

  .word {
    width: min(100%, 920px);
    margin: 0 auto;
    --lockup-word: var(--text);
    --lockup-mark: var(--accent);
    --lockup-shadow: #1f2826;
  }

  .intro {
    max-width: 48rem;
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .claim {
    color: var(--text);
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -.02em;
    text-wrap: balance;
    margin: 0;
  }

  .summary {
    color: var(--secondary);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.5;
    max-width: 38ch;
    margin: 0;
    text-wrap: balance;
  }

  .acts {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    margin-top: var(--space-4);
  }

  .quiet {
    color: var(--secondary);
    font-weight: 500;
    text-decoration: none;
  }

  .quiet:hover {
    color: var(--text);
  }

  /* Pixel down-indicator */
  .hero-scroll {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s steps(1);
  }

  .hero-scroll:hover {
    color: var(--accent);
  }

  .scroll-tag {
    font: var(--text-xs) var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .scroll-chevron {
    width: 10px;
    height: 6px;
    background:
      linear-gradient(currentColor, currentColor) 0 0 / 2px 2px no-repeat,
      linear-gradient(currentColor, currentColor) 2px 2px / 2px 2px no-repeat,
      linear-gradient(currentColor, currentColor) 4px 4px / 2px 2px no-repeat,
      linear-gradient(currentColor, currentColor) 6px 2px / 2px 2px no-repeat,
      linear-gradient(currentColor, currentColor) 8px 0 / 2px 2px no-repeat;
    animation: chevron-bob 1.4s steps(1) infinite;
  }

  /* Stepped like the films' cursor: down one grid pixel, then two, then back. */
  @keyframes chevron-bob {
    0%, 70%, 100% { transform: translateY(0); }
    75%, 95% { transform: translateY(var(--px)); }
    80%, 90% { transform: translateY(calc(var(--px) * 2)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-chevron {
      animation: none;
    }
  }

  /* ---------- bench: the film loop ---------- */
  .bench {
    padding-block: var(--space-12) var(--space-16);
  }

  /* ---------- Scan R1 section: the device and its face ---------- */
  .r1 {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .r1-face {
    display: grid;
    gap: var(--space-6);
    justify-items: center;
  }

  .r1-face > :global(*) {
    width: min(100%, 17rem);
  }

  @media (max-width: 44rem) {
    .r1 {
      grid-template-columns: 1fr;
    }
  }
</style>
