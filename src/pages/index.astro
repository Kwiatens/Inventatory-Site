---
/**
 * The homepage. The hero's pixel art is drawn on the lockup's grid. The film explains the
 * workflow; the highlights name each desktop feature. The Scan R1 and the racks are generated from
 * models (scripts/pixel-art), and the scanner's screens come from its firmware
 * (scripts/scan-r1-lcd).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Lockup from '../components/Lockup.astro';
import PixelSprite from '../components/concept/PixelSprite.astro';
import LcdPanel from '../components/concept/LcdPanel.astro';
import Film from '../components/concept/Film.astro';
import Keypad from '../components/concept/Keypad.astro';
import Scanner from '../components/home/Scanner.astro';
import Highlights from '../components/home/Highlights.astro';
import PlatformInstallSelector from '../components/PlatformInstallSelector.astro';
import art from '../data/pixel-art.json';
import { hero } from '../data/home';
import { url } from '../lib/url';
---
<BaseLayout title="Inventory for electronics">
  <section class="hero" aria-label="Introduction">
    <div class="hero-bg" aria-hidden="true">
      <video class="hero-video" autoplay loop muted playsinline preload="auto" poster={url('/media/scan-r1-poster.png')}>
        <source src={url('/media/scan-r1-turntable.webm')} type="video/webm" />
      </video>
      <canvas class="hero-pixels"></canvas>
    </div>

    <div class="wrap hero-inner">
      <div class="hero-logo">
        <Lockup tone="flat" cursor animate shadow={false} label="Inventatory" />
      </div>
      <h1 class="claim">{hero.title.join(' ')}</h1>
      <p class="summary">{hero.summary}</p>
      <div class="acts">
        <a class="press" href="#homepage-download">{hero.primary}</a>
        <a class="quiet go" href="#how">{hero.secondary}</a>
      </div>
    </div>
  </section>

  <section id="how" class="how" aria-label="What the system does">
    <div class="wrap">
      <p class="film-caption" data-type>Here’s what the system does.</p>
      <Film />
    </div>
  </section>

  <div class="wrap">
    <Highlights />
  </div>

  <Scanner>
    <div slot="model" class="r1" data-r1>
      <PixelSprite data={art.scanner} class="r1-art" label="Inventatory Scan R1" />
      <div class="r1-face">
        <LcdPanel label="Scan R1 display, as rendered by its firmware" />
        <Keypad />
      </div>
    </div>
  </Scanner>

  <div class="wrap"><PlatformInstallSelector id="homepage-download" /></div>
</BaseLayout>

<script>
  import { playScanR1 } from '../lib/scan-player';
  import { pixelVideo } from '../lib/pixel-video';

  // Keys flash in the sprite's keypad (and on a face-on keypad, when there is one).
  const press = (root: Element, key: string) => {
    const caps = root.querySelectorAll(`.faces [data-tag="key-${CSS.escape(key)}"]`);
    const face = root.querySelector(`[data-key="${CSS.escape(key)}"]`);
    caps.forEach(el => el.classList.add('pressed')); face?.classList.add('pressed');
    setTimeout(() => { caps.forEach(el => el.classList.remove('pressed')); face?.classList.remove('pressed'); }, 260);
  };

  // ---------- Scan R1 section: the device and its face, in the bench's pick flow ----------
  const r1 = document.querySelector<HTMLElement>('[data-r1]');
  if (r1) playScanR1(r1, {
    scenes: ['boot', 'pick', 'pick'],
    still: ['pick', 4200],
    onEvent: (_, event) => { if (event.startsWith('key:')) press(r1, event.slice(4)); },
  });

  // ---------- Hero background video: 0.5s persistence check on visibility ----------
  const heroVideo = document.querySelector<HTMLVideoElement>('.hero-video');
  const heroPixels = document.querySelector<HTMLCanvasElement>('.hero-pixels');
  if (heroVideo && heroPixels) pixelVideo(heroVideo, heroPixels);
  if (heroVideo) {
    let heroTimer: ReturnType<typeof setTimeout> | null = null;
    new IntersectionObserver(([e]) => {
      if (heroTimer) clearTimeout(heroTimer);
      const inView = e.isIntersecting;
      heroTimer = setTimeout(() => {
        if (inView) {
          heroVideo.play().catch(() => {});
        } else {
          heroVideo.pause();
        }
      }, 500);
    }, { threshold: 0.1 }).observe(heroVideo);
  }

</script>

<script>
  // The line types itself in once, the first time it is on screen, like the lockup's boot. The
  // text is in the markup already, so without JavaScript or with reduced motion it simply shows.
  const line = document.querySelector<HTMLElement>('[data-type]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (line && !reduced.matches) {
    const text = line.textContent ?? '';
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      line.textContent = '';
      line.classList.add('typing');
      let i = 0;
      const type = () => {
        i++;
        line.textContent = text.slice(0, i);
        if (i < text.length) {
          setTimeout(type, 38);
        } else {
          setTimeout(() => line.classList.remove('typing'), 500);
        }
      };
      setTimeout(type, 150);
    }, { threshold: 0.6 });
    observer.observe(line);
  }
</script>

<style is:global>
  /* The page's column is the film's width at 3x, so everything lines up with it. */
  :root { --width: 72rem; }
  /* Switchable pixels in generated sprites: gone (no part), lit (just placed), pressed (key). */
  .pixel-sprite [data-tag].gone, .pixel-art [data-tag].gone { opacity: 0; }
  .pixel-sprite .faces [data-tag].lit, .pixel-art .faces [data-tag].lit { fill: var(--focus); }
  .pixel-sprite .faces [data-tag].pressed { fill: var(--accent); }
</style>

<style>
  /* ---------- hero: the product video behind the claim, text on the left ---------- */
  .hero {
    position: relative;
    width: 100%;
    min-height: calc(100svh - var(--header-height));
    display: flex;
    align-items: center;
    overflow: hidden;
    box-sizing: border-box;
    padding-block: var(--space-16);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* The video is the source; the canvas shows it on the art grid (lib/pixel-video). */
  .hero-video {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .hero-pixels {
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  @media (min-width: 44rem) {
    .hero-pixels { transform: translateX(9%); }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-logo {
    width: min(100%, 18rem);
    --lockup-word: var(--text);
    --lockup-mark: var(--text);
  }

  .claim {
    margin-top: var(--space-12);
    max-width: 16ch;
    color: var(--text);
    font-size: clamp(2.25rem, 4.6vw, 3.75rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -.02em;
    text-wrap: balance;
  }

  .summary {
    margin-top: var(--space-6);
    max-width: 38ch;
    color: var(--secondary);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.5;
    text-wrap: balance;
  }

  .acts {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .quiet {
    color: var(--secondary);
    font-weight: 500;
    text-decoration: none;
  }

  .quiet:hover { color: var(--text); }

  /* ---------- how it works: the film, with one sentence above it ---------- */
  .how { padding-block: var(--space-20) var(--space-12); }
  /* Set large on the page itself, with no rule, so it reads as floating over the film's background. */
  .film-caption {
    margin-bottom: var(--space-8);
    color: var(--text);
    font-size: var(--text-h2);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -.01em;
  }
  /* While it types, an accent block stands in for the cursor; it goes when the line is complete. */
  .film-caption.typing::after {
    content: '';
    display: inline-block;
    width: .5em;
    height: .9em;
    margin-left: .1em;
    vertical-align: -.1em;
    background: var(--accent);
  }

  /* ---------- Scan R1 section: the device and its face ---------- */
  .r1 {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .r1-face {
    display: grid;
    gap: var(--space-6);
    justify-items: center;
  }

  .r1-face > :global(*) {
    width: min(100%, 17rem);
  }

  @media (max-width: 44rem) {
    /* On phones the art gets a band of its own above the text, so it never sits behind the claim. */
    .hero { display: block; min-height: auto; padding-block: var(--space-6) var(--space-12); }
    .hero-bg { position: relative; inset: auto; height: 15.5rem; margin-inline: calc(var(--gutter) * -1); }
    .hero-inner { margin-top: var(--space-8); }
    .claim { margin-top: var(--space-8); }
    .r1 {
      grid-template-columns: 1fr;
    }
  }
</style>
