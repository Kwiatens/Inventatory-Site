---
/**
 * The homepage. The hero leads with the wordmark, over stand-in footage drawn
 * through the films' dither. The film explains the workflow, as a player with chapters; the app
 * section shows each desktop feature on its own clip. The Scanner R1 and the racks are generated from
 * models (scripts/pixel-art), and the scanner's screens come from its firmware
 * (scripts/scan-r1-lcd).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Film from '../components/concept/Film.astro';
import Scanner from '../components/home/Scanner.astro';
import Lockup from '../components/Lockup.astro';
import AppFeatures from '../components/home/AppFeatures.astro';
import PlatformInstallSelector from '../components/PlatformInstallSelector.astro';
import { hero, film, install } from '../data/home';
import { url } from '../lib/url';
---
<BaseLayout title="Inventory for electronics">
  <section id="top" class="hero" data-section="top" aria-label="Introduction">
    <div class="footage" aria-hidden="true">
      <video data-footage-video muted loop playsinline autoplay preload="auto" src={url('/media/scan-r1-turntable.webm')}></video>
      <canvas data-footage></canvas>
      <span class="footage-tag">Placeholder footage</span>
    </div>

    <div class="wrap hero-copy">
      <h1 class="logo"><Lockup tone="flat" shadow={false} label="Inventatory" /></h1>
      <p class="summary">{hero.summary}</p>
      <div class="acts">
        <a class="press" href="#homepage-download">{hero.primary}</a>
        <a class="go watch" href="#how">{hero.secondary}</a>
      </div>
    </div>
  </section>

  <section id="how" class="how band" data-section="how" aria-labelledby="film-title">
    <div class="wrap">
      <div class="how-head">
        <h2 id="film-title" class="px-head">{film.title}</h2>
        <p>{film.summary}</p>
      </div>
      <Film />
    </div>
  </section>

  <AppFeatures />

  <Scanner />

  <div class="wrap" data-section="homepage-download"><PlatformInstallSelector id="homepage-download" title={install.title} lead={install.lead} sources={install.sources} /></div>
</BaseLayout>

<script>
  import { pixelVideo } from '../lib/pixel-video';

  // ---------- hero: the stand-in footage, through the films' dither ----------
  const video = document.querySelector<HTMLVideoElement>('[data-footage-video]');
  const footage = document.querySelector<HTMLCanvasElement>('[data-footage]');
  if (video && footage) {
    pixelVideo(video, footage);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) video.pause();
  }
</script>

<style is:global>
  /* The page's column is the film's width at 3x, so everything lines up with it. */
  :root { --width: 72rem; }
  /* Switchable pixels in generated sprites: gone (no part), lit (just placed), pressed (key). */
  .pixel-sprite [data-tag].gone, .pixel-art [data-tag].gone { opacity: 0; }
  .pixel-sprite .faces [data-tag].lit, .pixel-art .faces [data-tag].lit { fill: var(--focus); }
  .pixel-sprite .faces [data-tag].pressed { fill: var(--accent); }
</style>

<style>
  /* ---------- hero: the claim on the left, the footage behind it on the right ---------- */
  .hero { position: relative; min-height: min(56rem, calc(100svh - var(--header-height))); display: grid; grid-template: 1fr auto / minmax(0, 1fr); overflow: hidden; }
  .footage { position: absolute; inset: 0 0 0 34%; }
  .footage video { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .footage canvas { display: block; image-rendering: pixelated; }
  .footage-tag { position: absolute; right: var(--gutter); bottom: var(--space-6); color: var(--muted); font: var(--text-xs)/1 var(--font-mono); }
  /* Top-aligned on a whole grid step, not centred: centring lands the mark on half pixels. */
  .hero-copy { position: relative; align-self: center; padding-block: var(--space-12) calc(var(--space-12) + 6svh); }
  /* Six cells of two grid pixels: the chevron sits half a cell lower, so the cell must be even. */
  /* The wordmark leads, in graphite. It is 99 by 10 pixels: set at a whole number of screen
     pixels per pixel (two grid pixels each) so every block stays sharp. */
  .logo { width: calc(var(--px) * 198); margin: 0 0 var(--space-6); --lockup-word: var(--graphite); --lockup-mark: var(--graphite); }
  .logo :global(svg) { display: block; width: 100%; height: auto; }
  .summary { margin-top: var(--space-6); max-width: 33rem; text-wrap: pretty; color: var(--secondary); font-size: clamp(1.05rem, 1.4vw, 1.1875rem); line-height: 1.6; }
  .acts { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-8); margin-top: var(--space-8); }
  .watch { color: var(--secondary); text-decoration: none; font-weight: 500; }
  .watch:hover { color: var(--text); }

  /* ---------- how it works: the film, in a surface band with dithered edges ---------- */
  .how { padding-block: var(--section-y); }
  /* One centred title in the pixel font, the only one on the page, with the mascot sitting on
     the corner of the s, its legs over the end. */
  .how-head { display: grid; justify-items: center; gap: var(--space-6); margin-bottom: var(--space-12); padding-top: calc(var(--px) * 12); text-align: center; }
  .how-head p { max-width: 36rem; color: var(--secondary); font-size: 1.125rem; line-height: 1.6; text-wrap: pretty; }

  @media (max-width: 40rem) {
    .logo { width: 297px; }
  }

  @media (max-width: 56rem) {
    /* The footage goes behind the claim, dimmed. */
    .footage { inset: 0; opacity: .35; }
  }

</style>
