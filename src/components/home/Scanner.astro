---
/** Scan R1: the model, its description, and the two routes to owning one: everything is open
 *  source and free to build; the official CAD files are the way to support the project (pay
 *  what you want). The purchase button stays disabled until home.json has a destination. */
import { scanner } from '../../data/home';
import { features } from '../../data/site';
import { url } from '../../lib/url';

const model = features.find(item => item.label === 'Scan R1');
if (!model) throw new Error('Missing Scan R1 feature data.');
const external = (href: string) => /^https?:/.test(href);
const { bundle } = scanner;
---
<section id="scanner" class="scanner" aria-labelledby="scanner-title">
  <div class="wrap">
    <div class="stage">
      <div class="stage-copy">
        <h2 id="scanner-title" class="scanner-name">{scanner.title}</h2>
        <p class="summary">{scanner.summary}</p>
      </div>

      <slot name="model">
        <div class="model" data-scanner-model>
          <img class="still" src={url(model.media.src)} alt={model.media.alt} width={model.media.width} height={model.media.height} loading="lazy" decoding="async" />
          <video data-scanner-video muted loop playsinline preload="none" poster={url(model.media.src)} aria-hidden="true">
            <source src={url(model.media.video)} type="video/webm" />
          </video>
        </div>
      </slot>
    </div>

    <div class="routes">
      <article class="route" aria-labelledby="route-open">
        <h3 id="route-open">{scanner.open.title}</h3>
        <p>{scanner.open.text}</p>
        <ul class="links">
          {scanner.open.links.map(link => <li>
            <a class={external(link.href) ? 'out' : 'go'} href={external(link.href) ? link.href : url(link.href)}>{link.label}</a>
          </li>)}
        </ul>
      </article>

      <article class="route" aria-labelledby="route-bundle">
        <h3 id="route-bundle">{bundle.title}</h3>
        <p>{bundle.text}</p>
        <table class="manifest">
          <caption class="sr-only">Bundle contents</caption>
          <thead><tr><th scope="col">Item</th><th scope="col">Format</th></tr></thead>
          <tbody>{bundle.contents.map(row => <tr><td>{row.item}</td><td>{row.note}</td></tr>)}</tbody>
        </table>
        <div class="buy">
          <div class="price">
            <span class="pricing">{bundle.pricing}</span>
            <span class="delivery">{bundle.delivery}</span>
          </div>
          {bundle.href
            ? <a class="press" href={bundle.href}>{bundle.cta}</a>
            : <span class="press" aria-disabled="true">Coming soon</span>}
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  const model = document.querySelector<HTMLElement>('[data-scanner-model]');
  const video = model?.querySelector<HTMLVideoElement>('[data-scanner-video]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (model && video) {
    let visible = false;
    const update = () => {
      if (!visible || reduced.matches || document.hidden) { video.pause(); return; }
      video.play().then(() => { model.dataset.playing = 'true'; }).catch(() => {});
    };
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; update(); }, { rootMargin: '200px' }).observe(model);
    document.addEventListener('visibilitychange', update);
    reduced.addEventListener('change', update);
  }
</script>

<style>
  .scanner { padding-block: var(--space-20); }

  .stage { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: var(--space-12); align-items: center; }
  .scanner-name { margin: 0; color: var(--text); font-size: var(--text-h2); font-weight: 600; letter-spacing: -.01em; }
  .summary { max-width: 38ch; margin-top: var(--space-4); color: var(--secondary); font-size: var(--text-lead); line-height: 1.6; }

  .model { position: relative; display: grid; aspect-ratio: 1200 / 820; }
  .model > img, .model > video { grid-area: 1 / 1; position: relative; z-index: 1; width: 100%; height: 100%; object-fit: contain; }
  .model > video { opacity: 0; mix-blend-mode: lighten; }
  .model[data-playing="true"] > video { opacity: 1; }
  .model[data-playing="true"] > .still { opacity: 0; }

  /* Two columns, one rule between them. No boxes: the rule and the type do the separating. */
  .routes { display: grid; grid-template-columns: 1fr 1fr; margin-top: var(--space-16); border-top: var(--border) solid var(--divider); }
  .route { display: flex; flex-direction: column; min-width: 0; padding: var(--space-8) var(--space-8) 0 0; }
  .route + .route { padding: var(--space-8) 0 0 var(--space-8); border-left: var(--border) solid var(--divider); }
  .route h3 { margin-bottom: var(--space-3); color: var(--text); font-size: var(--text-lead); font-weight: 600; }
  .route > p { max-width: 46ch; color: var(--secondary); line-height: 1.65; }

  .links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-8); margin: var(--space-6) 0 0; padding: 0; list-style: none; font: var(--text-sm)/1.5 var(--font-mono); }
  .links li { margin: 0; }
  .links a { text-decoration: none; }

  .manifest { width: 100%; margin-top: var(--space-6); border-collapse: collapse; font-size: var(--text-sm); line-height: 1.4; }
  .manifest th { padding: 0 0 var(--space-2); color: var(--muted); font: 400 var(--text-xs)/1.5 var(--font-mono); text-align: left; text-transform: uppercase; letter-spacing: .06em; }
  .manifest td { height: 2.5rem; padding: 0; border-top: var(--border) solid var(--divider); color: var(--text); vertical-align: middle; white-space: nowrap; }
  .manifest :is(th, td):last-child { width: 1%; padding-left: var(--space-6); text-align: right; }
  .manifest td:last-child { color: var(--secondary); font: var(--text-xs)/1.4 var(--font-mono); letter-spacing: .04em; }

  .buy { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-4) var(--space-6); margin-top: auto; padding: var(--space-8) 0; }
  .price { display: flex; flex-direction: column; gap: var(--space-1); }
  .pricing { color: var(--text); font-weight: 600; }
  .delivery { color: var(--muted); font: var(--text-xs)/1.4 var(--font-mono); }
  /* Until there is a destination the button is shown, but does nothing. */
  .buy .press[aria-disabled="true"] { --c: var(--hover); color: var(--muted); pointer-events: none; }
  .buy .press[aria-disabled="true"]::after { --c: var(--canvas); }

  @media (max-width: 56rem) {
    .stage { grid-template-columns: 1fr; }
    .model { order: -1; }
  }
  @media (max-width: 44rem) {
    .scanner { padding-block: var(--space-16); }
    .routes { grid-template-columns: 1fr; }
    .route, .route + .route { padding: var(--space-8) 0 0; border-left: 0; }
    .route + .route { border-top: var(--border) solid var(--divider); margin-top: var(--space-8); }
    .manifest td:last-child { font-size: .6875rem; letter-spacing: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .model > video { display: none; } }
</style>
