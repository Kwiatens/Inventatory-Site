---
/** Scan R1: the model, its description, and the two routes to owning one: everything is open
 *  source and free to build; the official CAD files are the way to support the project (pay
 *  what you want). */
import { scanner } from '../../data/home';
import { features } from '../../data/site';
import { url } from '../../lib/url';

const model = features.find(item => item.label === 'Scan R1');
if (!model) throw new Error('Missing Scan R1 feature data.');
const external = (href: string) => /^https?:/.test(href);
---
<section id="scanner" class="scanner" aria-labelledby="scanner-heading">
  <div class="wrap">
    <div class="stage">
      <div class="stage-copy">
        <h2 id="scanner-heading" class="px-head">{scanner.title}</h2>
        <p class="summary">{scanner.summary}</p>
      </div>

      <slot name="model">
        <div class="model" data-scanner-model>
          <img class="still" src={url(model.media.src)} alt={model.media.alt} width={model.media.width} height={model.media.height} loading="lazy" decoding="async" />
          <video data-scanner-video muted loop playsinline preload="none" poster={url(model.media.src)} aria-hidden="true">
            <source src={url(model.media.video)} type="video/webm" />
          </video>
        </div>
      </slot>
    </div>

    <div class="routes">
      <article class="route open frame" aria-labelledby="route-open">
        <header>
          <h3 id="route-open" class="px-sub">{scanner.open.title}</h3>
        </header>
        <p>{scanner.open.text}</p>
        <ul class="foot links">
          {scanner.open.links.map(link => <li>
            <a class={external(link.href) ? 'out' : 'go'} href={external(link.href) ? link.href : url(link.href)}>{link.label}</a>
          </li>)}
        </ul>
      </article>

      <article class="route bundle frame" aria-labelledby="route-bundle">
        <header>
          <h3 id="route-bundle" class="px-sub">{scanner.bundle.title}</h3>
        </header>
        <p>{scanner.bundle.text}</p>
        <table class="manifest">
          <caption class="sr-only">Bundle contents</caption>
          <thead><tr><th scope="col">Item</th><th scope="col">Format</th></tr></thead>
          <tbody>{scanner.bundle.contents.map(row => <tr><td>{row.item}</td><td>{row.note}</td></tr>)}</tbody>
        </table>
        <div class="foot buy">
          <div class="price-block">
            <span class="price px-sub">{scanner.bundle.pricing}</span>
            <span class="delivery">{scanner.bundle.delivery}</span>
          </div>
          <a class="press" href={scanner.bundle.href}>{scanner.bundle.cta}</a>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  const model = document.querySelector<HTMLElement>('[data-scanner-model]');
  const video = model?.querySelector<HTMLVideoElement>('[data-scanner-video]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (model && video) {
    let visible = false;
    const update = () => {
      if (!visible || reduced.matches || document.hidden) { video.pause(); return; }
      video.play().then(() => { model.dataset.playing = 'true'; }).catch(() => {});
    };
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; update(); }, { rootMargin: '200px' }).observe(model);
    document.addEventListener('visibilitychange', update);
    reduced.addEventListener('change', update);
  }
</script>

<style>
  .scanner { position: relative; padding-block: var(--space-20); overflow: hidden; }

  .stage { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: var(--space-12); align-items: center; }
  h2, h3 { margin: 0; }
  .summary { max-width: 38ch; margin-top: var(--space-6); font-size: var(--text-lead); line-height: 1.6; }

  .model { position: relative; display: grid; aspect-ratio: 1200 / 820; }
  .model > img, .model > video { grid-area: 1 / 1; position: relative; z-index: 1; width: 100%; height: 100%; object-fit: contain; }
  .model > video { opacity: 0; mix-blend-mode: lighten; }
  .model[data-playing="true"] > video { opacity: 1; }
  .model[data-playing="true"] > .still { opacity: 0; }

  /* ---------- the two routes: same skeleton, so their footers share one line ---------- */
  .routes { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); margin-top: var(--space-16); }
  .route { position: relative; display: flex; flex-direction: column; padding: var(--space-8); }
  .route header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 2rem; margin-bottom: var(--space-4); }
  .route > p { max-width: 44ch; font-size: var(--text-base); line-height: 1.65; }
  /* Rules on the grid: one art pixel thick, dotted like the films' leaders. */
  .foot, .manifest td, .manifest th { --rule: var(--divider); background: linear-gradient(90deg, var(--rule) 50%, transparent 0) 0 0 / calc(var(--px) * 2) var(--px) repeat-x; }
  .manifest td, .manifest th { background-position: 0 100%; }
  .foot {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4) var(--space-6);
    /* Tall enough for the pricing block (a pixel subheading over a small line), so both
       footers start on the same line. */
    min-height: calc(max(3.625rem, var(--px) * 13 + var(--space-2) + var(--text-xs) * 1.4) + var(--space-6));
    margin: auto 0 0; padding: var(--space-6) 0 0;
  }
  /* Keep at least this much air above the footer when a card is the taller one. */
  .route > :is(p, .manifest):has(+ .foot) { margin-bottom: var(--space-8); }

  /* Open route: the repository itself. */
  .open { --fill: var(--surface); }
  .links { justify-content: flex-start; gap: var(--space-2) var(--space-8); list-style: none; font: var(--text-sm)/1.5 var(--font-mono); }
  .links li { margin: 0; }
  .links a { text-decoration: none; }

  /* Bundle route: the way to support the project. Set apart by a lit outline, a tinted inside,
     the pricing line and the one filled button in the section, rather than by volume. */
  .bundle { --frame: var(--accent); --fill: var(--active-soft); }
  .bundle > p { color: var(--secondary); }
  .bundle :is(.foot, td, th) { --rule: var(--active); }

  /* Contents: one line per file, the item and its format. */
  .manifest { width: 100%; margin-top: var(--space-6); border-collapse: collapse; font-size: var(--text-sm); line-height: 1.4; }
  .manifest th { padding: 0 0 var(--space-2); color: var(--muted); font: 400 var(--text-xs)/1.5 var(--font-mono); text-align: left; text-transform: uppercase; letter-spacing: .06em; }
  .manifest td { height: 2.5rem; padding: 0; color: var(--text); vertical-align: middle; white-space: nowrap; }
  .manifest tr:last-child td { background: none; }
  .manifest :is(th, td):last-child { width: 1%; padding-left: var(--space-6); text-align: right; }
  .manifest td:last-child { color: var(--link); font: var(--text-xs)/1.4 var(--font-mono); letter-spacing: .04em; }

  .price-block { display: flex; flex-direction: column; gap: var(--space-2); }
  .delivery { color: var(--muted); font: var(--text-xs)/1.4 var(--font-mono); }

  @media (max-width: 56rem) {
    .stage, .routes { grid-template-columns: 1fr; }
    .model { order: -1; }
  }
  @media (max-width: 40rem) {
    .scanner { padding-block: var(--space-16); }
    .route { padding: var(--space-6) var(--space-4); }
    /* Phones: the formats speak for themselves, so the header row is kept for screen
       readers only and the item gets the width it needs to stay on one line. */
    .manifest { font-size: var(--text-xs); }
    .manifest thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .manifest :is(th, td):last-child { padding-left: var(--space-2); }
    .manifest td:last-child { font-size: .6875rem; letter-spacing: 0; }
  }
  /* Below a 375px screen the longest item no longer fits; let it wrap rather than clip. */
  @media (max-width: 23.4rem) {
    .manifest td { white-space: normal; padding-block: var(--space-2); }
  }
  @media (prefers-reduced-motion: reduce) { .model > video { display: none; } }
</style>
