---
/**
 * What the system does, as the life of a part.
 * Without JavaScript every step is listed in order with its own media. With JavaScript the
 * steps become an accordion: one step open at a time, its media shown in a single
 * frame beside the list on wide screens, advancing on its own until the visitor picks one.
 */
import { workflow, steps } from '../../data/home';
import { url } from '../../lib/url';
---
<section id="features" class="lifecycle wrap" aria-labelledby="lifecycle-heading" data-lifecycle>
  <header class="intro">
    <h2 id="lifecycle-heading">
      {workflow.headingLines.map((line, i) => (
        <Fragment key={i}>{line}{i < workflow.headingLines.length - 1 && <br />}</Fragment>
      ))}
    </h2>
    {workflow.summary && <p>{workflow.summary}</p>}
  </header>

  <div class="layout">
    <div class="steps" data-track>
      {steps.map((step) => (
        <article class="step" id={step.id} data-step aria-labelledby={`step-${step.id}`}>
          <h3 id={`step-${step.id}`}>
            <button type="button" class="toggle" aria-expanded="true" aria-controls={`body-${step.id}`} data-toggle>
              {step.title}
            </button>
          </h3>
          <div class="body" id={`body-${step.id}`}>
            <div class="inner">
              <div class="text">
                <p>{step.text}</p>
                <a class="more" href={url(step.href)}>{workflow.readGuideText} <span aria-hidden="true">→</span></a>
              </div>
              <figure class="media">
                {step.media
                  ? <img src={url(step.media.src)} alt={step.media.alt} width={step.media.width} height={step.media.height} loading="lazy" decoding="async" style={{ objectPosition: step.media.position, '--zoom': step.media.zoom ?? 1 }} />
                  : <div class="pending" role="img" aria-label={`${step.mediaCaption}: ${workflow.recordingPendingText}`}><span>{workflow.recordingPendingText}</span></div>}
              </figure>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Wide screens: one frame for the open step's media. -->
    <div class="stage" data-stage>
      {steps.map((step, i) => (
        <figure class="frame" data-frame aria-hidden={i === 0 ? undefined : 'true'}>
          <div class="frame-media">
            {step.media
              ? <img src={url(step.media.src)} alt={step.media.alt} width={step.media.width} height={step.media.height} loading="lazy" decoding="async" style={{ objectPosition: step.media.position, '--zoom': step.media.zoom ?? 1 }} />
              : <div class="pending" role="img" aria-label={`${step.mediaCaption}: ${workflow.recordingPendingText}`}><span>{workflow.recordingPendingText}</span></div>}
          </div>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  const AUTO_MS = 7000;
  const section = document.querySelector<HTMLElement>('[data-lifecycle]');
  const items = [...(section?.querySelectorAll<HTMLElement>('[data-step]') ?? [])];
  const toggles = items.map(item => item.querySelector<HTMLButtonElement>('[data-toggle]')!);
  const frames = [...(section?.querySelectorAll<HTMLElement>('[data-frame]') ?? [])];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  // The side-by-side layout; on narrow screens the media sits inside the open step and
  // advancing on its own would move the page under the reader, so it only runs here.
  const wide = window.matchMedia('(min-width: 64.01rem)');

  if (section && items.length > 1 && frames.length === items.length) {
    let current = 0;
    let timer = 0;
    let auto = !reduced.matches; // stops for good once the visitor chooses a step
    let visible = false;
    let paused = false;

    const schedule = () => {
      window.clearTimeout(timer);
      const running = auto && wide.matches && visible && !paused && !document.hidden;
      section.dataset.autoplay = String(running);
      if (running) timer = window.setTimeout(() => select((current + 1) % items.length), AUTO_MS);
    };

    const select = (index: number) => {
      current = index;
      items.forEach((item, i) => {
        const open = i === index;
        item.classList.toggle('is-open', open);
        toggles[i].setAttribute('aria-expanded', String(open));
      });
      frames.forEach((frame, i) => {
        frame.classList.toggle('is-active', i === index);
        if (i === index) frame.removeAttribute('aria-hidden'); else frame.setAttribute('aria-hidden', 'true');
      });
      schedule();
    };

    const choose = (index: number) => { auto = false; select(index); };

    section.classList.add('is-enhanced');
    toggles.forEach((toggle, i) => {
      toggle.addEventListener('click', () => choose(i));
      toggle.addEventListener('keydown', (event) => {
        const last = toggles.length - 1;
        const keys: Record<string, number> = { ArrowDown: i === last ? 0 : i + 1, ArrowUp: i === 0 ? last : i - 1, Home: 0, End: last };
        const next = keys[event.key];
        if (next === undefined) return;
        event.preventDefault();
        toggles[next].focus();
      });
    });

    // Hold the rotation while the pointer or keyboard focus is inside the section.
    section.addEventListener('pointerenter', () => { paused = true; schedule(); });
    section.addEventListener('pointerleave', () => { paused = false; schedule(); });
    section.addEventListener('focusin', () => { paused = true; schedule(); });
    section.addEventListener('focusout', (event) => {
      if (!section.contains(event.relatedTarget as Node | null)) { paused = false; schedule(); }
    });
    document.addEventListener('visibilitychange', schedule);
    wide.addEventListener('change', schedule);
    reduced.addEventListener('change', () => { if (reduced.matches) auto = false; schedule(); });
    new IntersectionObserver((entries) => { visible = entries.some(entry => entry.isIntersecting); schedule(); }, { threshold: 0.35 }).observe(section);

    select(0);
  }
</script>

<style>
  .lifecycle { padding-block: var(--space-16) var(--space-20); }
  .intro { margin-bottom: var(--space-12); }
  .intro h2 { font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.2; letter-spacing: -.02em; }
  .intro p { max-width: 40ch; margin-top: var(--space-4); color: var(--muted); }

  .layout { display: grid; gap: var(--space-12); }

  /* ---------- step list ---------- */
  .step { position: relative; }
  h3 { margin: 0; font: inherit; }
  .toggle {
    display: block; width: 100%;
    padding: var(--space-6) 0; background: none; border: 0; color: var(--text); text-align: left;
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem); font-weight: 500; line-height: 1.3; letter-spacing: -.01em;
  }
  .toggle:focus-visible { outline-offset: -2px; }


  .text > p { max-width: 42ch; color: var(--secondary); font-size: var(--text-base); line-height: 1.65; }
  .more { display: inline-block; margin-top: var(--space-4); font: var(--text-sm)/1.5 var(--font-mono); text-decoration: none; }
  .more span { display: inline-block; transition: transform .2s; }
  .more:hover span { transform: translateX(3px); }
  .inner { padding-bottom: var(--space-6); }

  /* ---------- media ---------- */
  .media, .frame-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface); border: var(--border) solid var(--divider); }
  .media { margin-top: var(--space-6); }
  :is(.media, .frame-media) img { width: 100%; height: 100%; object-fit: cover; transform: scale(var(--zoom)); transform-origin: var(--origin, 100% 0); }
  .pending { position: absolute; inset: 0; display: grid; place-items: center; border: var(--border) dashed var(--divider); margin: var(--space-4); }
  .pending span { color: var(--muted); font: var(--text-xs)/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .stage { display: none; }

  /* ---------- enhanced: accordion ---------- */
  .is-enhanced .toggle { cursor: pointer; color: var(--muted); transition: color .2s; }
  .is-enhanced .toggle:hover { color: var(--secondary); }
  .is-enhanced .is-open .toggle { color: var(--text); cursor: default; }
  .is-enhanced .body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .45s cubic-bezier(.65, 0, .35, 1); }
  .is-enhanced .inner { min-height: 0; overflow: hidden; padding-bottom: 0; visibility: hidden; transition: visibility 0s .45s, padding .45s cubic-bezier(.65, 0, .35, 1); }
  .is-enhanced .is-open .body { grid-template-rows: 1fr; }
  .is-enhanced .is-open .inner { visibility: visible; padding-bottom: var(--space-6); transition-delay: 0s; }

  /* ---------- wide: list beside a single frame ---------- */
  @media (min-width: 64.01rem) {
    .is-enhanced .layout { grid-template-columns: minmax(0, 25rem) minmax(0, 1fr); gap: var(--space-16); align-items: start; }
    .is-enhanced .media { display: none; }
    .is-enhanced .stage { display: grid; }
    .frame { grid-area: 1 / 1; margin: 0; opacity: 0; visibility: hidden; transition: opacity .4s ease, visibility 0s .4s; }
    .frame.is-active { opacity: 1; visibility: visible; transition-delay: 0s; }
  }
  @media (max-width: 40rem) {
    .lifecycle { padding-block: var(--space-8) var(--space-16); }
    .toggle { padding-block: var(--space-4); }
  }
</style>
