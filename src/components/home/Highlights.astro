---
/**
 * The desktop features, one row each: a pixel icon, the claim, and the guide. Icons are drawn on
 * a 16 x 16 grid of art pixels (rectangles, [x, y, width, height, lit]); the lit pixel is the
 * accent. Copy comes from home.json (highlights).
 */
import { highlights } from '../../data/home';
import { url } from '../../lib/url';

type Rect = [x: number, y: number, w: number, h: number, lit?: boolean];

const icons: Record<string, Rect[]> = {
  // A file drops into a tray.
  import: [
    [7, 1, 2, 6], [4, 7, 8, 1], [5, 8, 6, 1], [6, 9, 4, 1], [7, 10, 2, 1],
    [1, 12, 1, 3], [14, 12, 1, 3], [1, 14, 14, 1],
  ],
  // Five by five slots; one is lit.
  racks: [
    [1, 1, 2, 2], [4, 1, 2, 2], [7, 1, 2, 2], [10, 1, 2, 2], [13, 1, 2, 2],
    [1, 4, 2, 2], [4, 4, 2, 2], [7, 4, 2, 2, true], [10, 4, 2, 2], [13, 4, 2, 2],
    [1, 7, 2, 2], [4, 7, 2, 2], [7, 7, 2, 2], [10, 7, 2, 2], [13, 7, 2, 2],
    [1, 10, 2, 2], [4, 10, 2, 2], [7, 10, 2, 2], [10, 10, 2, 2], [13, 10, 2, 2],
    [1, 13, 2, 2], [4, 13, 2, 2], [7, 13, 2, 2], [10, 13, 2, 2], [13, 13, 2, 2],
  ],
  // A board with pins and parts; one part is lit.
  projects: [
    [1, 3, 14, 1], [1, 12, 14, 1], [1, 3, 1, 10], [14, 3, 1, 10],
    [4, 1, 1, 2], [8, 1, 1, 2], [12, 1, 1, 2],
    [4, 6, 3, 2], [9, 6, 3, 2], [9, 9, 3, 2, true],
  ],
  // A magnifier: a ring of ten pixels across, and a stepped handle.
  stock: [
    [4, 1, 4, 1], [2, 2, 2, 1], [8, 2, 2, 1],
    [1, 3, 1, 6], [10, 3, 1, 6],
    [2, 9, 2, 1], [8, 9, 2, 1], [4, 10, 4, 1],
    [11, 11, 2, 2], [13, 13, 2, 2],
  ],
  // Four checkpoints on a line; the last one is the current state.
  history: [
    [0, 7, 16, 1], [1, 6, 3, 3], [5, 6, 3, 3], [9, 6, 3, 3], [13, 6, 3, 3, true],
  ],
};
---
<section id="highlights" class="highlights" aria-labelledby="highlights-title">
  <h2 id="highlights-title" class="sr-only">What Inventatory does</h2>
  <ul class="rows">
    {highlights.map(item => (
      <li class="row">
        <svg class="icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
          {icons[item.icon].map(([x, y, w, h, lit]) => <rect x={x} y={y} width={w} height={h} class={lit ? 'lit' : undefined} />)}
        </svg>
        <div class="copy">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
        <a class="go" href={url(item.href)}>Read the guide</a>
      </li>
    ))}
  </ul>
</section>

<style>
  .highlights { padding-block: var(--space-16); }
  .rows { list-style: none; margin: 0; padding: 0; border-bottom: var(--border) solid var(--divider); }
  .row {
    display: grid;
    grid-template-columns: calc(var(--px) * 16) minmax(0, 1fr) auto;
    gap: var(--space-4) var(--space-8);
    align-items: start;
    margin: 0;
    padding-block: var(--space-8);
    border-top: var(--border) solid var(--divider);
  }
  .icon { display: block; width: calc(var(--px) * 16); height: auto; color: var(--secondary); }
  .icon rect { fill: currentColor; }
  .icon .lit { fill: var(--accent); }
  .copy { max-width: 52ch; }
  .copy h3 { margin-bottom: var(--space-2); color: var(--text); font-size: var(--text-lead); font-weight: 600; }
  .copy p { color: var(--secondary); }
  .row .go { white-space: nowrap; font: var(--text-sm)/1.5 var(--font-mono); }
  @media (max-width: 40rem) {
    .highlights { padding-block: var(--space-12); }
    .row { grid-template-columns: calc(var(--px) * 16) minmax(0, 1fr); gap: var(--space-3) var(--space-4); padding-block: var(--space-6); }
    .row .go { grid-column: 2; justify-self: start; }
  }
</style>
