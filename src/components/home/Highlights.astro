---
/**
 * The desktop features, one row each: a pixel icon, the claim, and the guide. A row opens to show
 * the feature on the real thing, in a video (`video` in home.json; until there is one, the slot
 * says so). Each icon is the real thing the feature works with, rendered from a model through the
 * film's renderer with the film's rack camera and fitted to the same box (scripts/pixel-art/icons.py):
 * the vendor bag, rack R1 with B3 lit, the comparator board and its BOM, the Scan R1, and the PC
 * showing the History page. Copy comes from home.json (highlights).
 */
import { highlights } from '../../data/home';
import { url } from '../../lib/url';
import { CODES, hex, type SpriteData } from '../../lib/pixel';
import cad from '../../data/feature-icons.json';

const BOX = cad.box;
type Icon = SpriteData & { tags: Record<string, number[][]> };
interface Run { x: number; y: number; w: number; fill: string }
/** One rect per run of a colour along a row, the art centred in the box; lit (tagged) pixels in
 *  the accent. */
function runs(art: Icon): Run[] {
  const lit = new Set(Object.values(art.tags ?? {}).flat().map(([x, y]) => x + ',' + y));
  const fill = (ch: string, x: number, y: number) => ch === '.' ? null : lit.has(x + ',' + y) ? 'var(--accent)' : hex(CODES[ch]);
  const ox = Math.floor((BOX - art.width) / 2), oy = Math.floor((BOX - art.height) / 2);
  const out: Run[] = [];
  art.rows.forEach((row, y) => {
    for (let x = 0; x < row.length;) {
      const f = fill(row[x], x, y);
      let n = 1;
      while (x + n < row.length && fill(row[x + n], x + n, y) === f) n++;
      if (f) out.push({ x: ox + x, y: oy + y, w: n, fill: f });
      x += n;
    }
  });
  return out;
}
const icons = cad as unknown as Record<string, Icon>;
---
<section id="highlights" class="highlights" aria-labelledby="highlights-title">
  <div class="title-block">
    <h2 id="highlights-title" class="px-head">System’s features</h2>
  </div>
  <ul class="rows rule">
    {highlights.map(item => (
      <li class="row rule" data-feature>
        <div class="head" data-head>
          <svg class="icon" viewBox={`0 0 ${BOX} ${BOX}`} aria-hidden="true" focusable="false" shape-rendering="crispEdges">
            {runs(icons[item.icon]).map(r => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}
          </svg>
          <h3 class="title">
            <button type="button" class="toggle" aria-expanded="false" aria-controls={`feature-${item.id}`} data-toggle>
              {item.title}<span class="mark" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="body">
            <p>{item.text}</p>
            <a class="go" href={url(item.href)}>Read the guide</a>
          </div>
        </div>
        <div class="panel" id={`feature-${item.id}`} role="region" aria-label={`${item.title}: video`} hidden data-panel>
          {item.video
            ? <video class="video" controls preload="none" playsinline poster={item.poster ? url(item.poster) : undefined} src={url(item.video)}></video>
            : <div class="video empty frame"><span class="soon">Video coming soon</span></div>}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  /* A table, one row per feature: the icon, the name, then what it does and where to read more.
     The names share one column, so they line up down the page. Rules are the dotted grid rule. */
  /* After the film's band: the band already gives its bottom space, so the rhythm is one section-y. */
  .highlights { padding-top: calc(var(--section-y) - var(--space-8)); }
  /* The heading is centred over the list. */
  .title-block { width: fit-content; margin: 0 auto var(--space-12); text-align: center; }
  .title-block h2 { text-align: center; }
  .rows { list-style: none; margin: 0; padding: 0; background-position: 0 100%; }
  .row { margin: 0; }
  .head, .panel {
    display: grid;
    grid-template-columns: calc(var(--px) * 44) minmax(0, 20rem) minmax(0, 1fr);
    gap: var(--space-2) var(--space-8);
  }
  /* The whole row opens it; the name is the button that keyboards and screen readers use. */
  .head { align-items: center; padding-block: var(--space-6); cursor: pointer; }
  .icon { display: block; width: calc(var(--px) * 44); height: calc(var(--px) * 44); }
  .title { color: var(--text); font-size: var(--text-lead); font-weight: 600; line-height: 1.3; }
  .toggle {
    display: inline-flex; align-items: baseline; gap: var(--space-3); padding: 0; border: 0;
    background: none; color: inherit; font: inherit; text-align: left; cursor: pointer;
  }
  .head:hover .toggle, .toggle:focus-visible { color: var(--focus); }
  /* Open or shut: a pixel plus that loses its upright when the row is open. */
  .mark {
    flex: none; width: calc(var(--px) * 5); height: calc(var(--px) * 5); align-self: center;
    background:
      linear-gradient(var(--accent), var(--accent)) 0 50% / 100% var(--px) no-repeat,
      linear-gradient(var(--accent), var(--accent)) 50% 0 / var(--px) 100% no-repeat;
  }
  .toggle[aria-expanded="true"] .mark { background: linear-gradient(var(--accent), var(--accent)) 0 50% / 100% var(--px) no-repeat; }
  .body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); max-width: 60ch; }
  .body p { color: var(--secondary); }
  .body .go { font: var(--text-sm)/1.5 var(--font-mono); }
  /* Open, the row shows the feature on the real thing under the name and the text, in a 16:9 slot. */
  .panel { padding-bottom: var(--space-8); }
  .panel[hidden] { display: none; }
  .video { grid-column: 2 / -1; display: block; width: 100%; max-width: 44rem; aspect-ratio: 16 / 9; }
  video.video { background: var(--canvas); }
  /* No video yet: the framed slot, a pixel play mark and a quiet status. */
  .empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-4); }
  .empty::before {
    content: ''; width: calc(var(--px) * 7); height: calc(var(--px) * 10); background: var(--divider);
    clip-path: polygon(0 0, 30% 0, 30% 10%, 45% 10%, 45% 20%, 60% 20%, 60% 30%, 75% 30%, 75% 40%, 100% 40%, 100% 60%, 75% 60%, 75% 70%, 60% 70%, 60% 80%, 45% 80%, 45% 90%, 30% 90%, 30% 100%, 0 100%);
  }
  .soon { color: var(--muted); font: var(--text-sm)/1 var(--font-mono); }
  @media (max-width: 40rem) {
    .head, .panel { grid-template-columns: calc(var(--px) * 44) minmax(0, 1fr); gap: var(--space-2) var(--space-4); }
    .head { align-items: start; }
    .icon { grid-row: span 2; }
    .body { grid-column: 2; }
    .video { grid-column: 1 / -1; }
  }
</style>

<script>
  // A row opens and shuts from anywhere on it but its links; closing it stops its video.
  for (const row of document.querySelectorAll<HTMLElement>('[data-feature]')) {
    const toggle = row.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const panel = row.querySelector<HTMLElement>('[data-panel]')!;
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (!open) panel.querySelector('video')?.pause();
    };
    const flip = () => set(toggle.getAttribute('aria-expanded') !== 'true');
    toggle.addEventListener('click', flip);
    row.querySelector('[data-head]')!.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('a, button')) flip();
    });
  }
</script>
