---
/**
 * Shared primary navigation, as the app's tab bar: the mark on the left, the home page's sections
 * as tabs in the middle, the way out and the app's clock on the right. On the home page the tab of
 * the section in view is the current one; elsewhere the tabs lead back to the home page.
 */
import { site } from '../data/site';
import { url } from '../lib/url';
import BrandMark from './BrandMark.astro';

const tabs = [
  ['top', 'Overview'], ['how', 'How it works'], ['app', 'The app'], ['scanner', 'Scan R1'], ['homepage-download', 'Install'],
] as const;
---
<header class="site-header">
  <BrandMark class="header-brand" />
  <nav class="tabs" aria-label="Sections">
    {tabs.map(([id, label]) => <a href={url(`/#${id}`)} data-tab={id}>{label}</a>)}
  </nav>
  <div class="header-end">
    <a href={url('/docs/')}>Docs</a>
    <a class="out" href={site.repository}>GitHub</a>
    <span class="clock" data-clock aria-hidden="true"></span>
  </div>
</header>

<script>
  // The clock, as in the app's bar.
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  const pad = (n: number) => String(n).padStart(2, '0');
  const tickClock = () => {
    const d = new Date();
    clock!.textContent = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
  };
  if (clock) { tickClock(); setInterval(tickClock, 1000); }

  // The tab bar follows the section in view (only the home page marks its sections).
  const tabs = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')].map(a => [a.dataset.tab!, a]));
  const seen = new Map<string, number>();
  const sections = document.querySelectorAll<HTMLElement>('[data-section]');
  if (sections.length) {
    const observer = new IntersectionObserver(entries => {
      for (const e of entries) seen.set((e.target as HTMLElement).dataset.section!, e.intersectionRatio);
      const best = [...seen].sort((a, b) => b[1] - a[1])[0];
      if (best) tabs.forEach((a, id) => a.toggleAttribute('aria-current', id === best[0]));
    }, { threshold: [0, .15, .3, .45, .6, .75, .9] });
    sections.forEach(s => observer.observe(s));
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 30; height: var(--header-height);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-6);
    padding-inline: var(--gutter); background: var(--canvas);
    font: var(--text-sm)/1 var(--font-mono);
    /* The app's rule under its bar: one line, the divider colour. */
    box-shadow: 0 1px 0 var(--divider);
  }
  /* The mark: ›i at rest, unfolding into the wordmark on hover. */
  .header-brand { justify-self: start; --h: 1rem; --lockup-word: var(--graphite); --lockup-mark: var(--graphite); }
  .header-brand:is(:hover, :focus-visible) { --lockup-mark: var(--accent); }
  .tabs { display: flex; }
  .tabs a, .header-end a { color: var(--secondary); text-decoration: none; padding: .55rem .6rem; white-space: pre; }
  .tabs a:hover, .header-end a:hover { color: var(--text); }
  /* The current section is the app's current tab: bold, light, on the divider. */
  .tabs a[aria-current] { color: var(--focus); background: var(--divider); font-weight: 600; }
  .header-end { display: flex; align-items: center; justify-content: flex-end; gap: var(--space-2); }
  .clock { color: var(--muted); margin-left: var(--space-3); font-variant-numeric: tabular-nums; }
  @media (max-width: 64rem) {
    .site-header { grid-template-columns: auto 1fr; }
    .tabs, .clock { display: none; }
  }
</style>
