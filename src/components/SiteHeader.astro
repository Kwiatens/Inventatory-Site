---
/** Shared primary navigation; it stays visible on narrow screens without JavaScript. */
import { nav } from '../data/site';
import { url, isCurrent } from '../lib/url';
import Lockup from './Lockup.astro';

const pages = nav.filter(item => !item.href.startsWith('https:'));
const external = nav.filter(item => item.href.startsWith('https:'));
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="header-brand" href={url('/')} aria-label="Inventatory home">
      <Lockup theme="gray" shadow={false} />
    </a>
    <nav aria-label="Primary navigation">
      {pages.map(item => <a href={url(item.href)} aria-current={isCurrent(Astro.url.pathname, item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="header-meta">
      {external.map(item => <a class="external" href={item.href}>{item.label}<span aria-hidden="true"> ↗</span></a>)}
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    border-bottom: var(--border) solid var(--divider);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .header-inner { min-height: var(--header-height); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-6); }
  .header-brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    opacity: .80;
    transition: opacity .15s ease;
  }
  .header-brand:hover { opacity: 1; }
  .header-brand :global(.lockup) { height: 1.25rem; width: auto; }
  nav { display: flex; gap: var(--space-1); }
  nav a {
    position: relative; padding: var(--space-2) var(--space-4);
    color: var(--secondary); text-decoration: none; font: var(--text-sm)/1.5 var(--font-mono);
    transition: background .15s, color .15s;
  }
  nav a:hover { background: var(--hover); color: var(--text); }
  nav a[aria-current] { color: var(--focus); }
  /* Active page: a row of pixel dashes, like the slots in the mark. */
  nav a[aria-current]::after {
    content: ''; position: absolute; left: var(--space-4); right: var(--space-4); bottom: 2px; height: 3px;
    background: repeating-linear-gradient(90deg, var(--accent) 0 3px, transparent 3px 5px);
  }
  .header-meta { justify-self: end; display: flex; align-items: center; gap: var(--space-4); font: var(--text-xs)/1.5 var(--font-mono); }
  .external {
    display: inline-flex; align-items: center; min-height: 2.125rem; padding: 0 var(--space-3);
    border: var(--border) solid var(--divider); color: var(--secondary); text-decoration: none; font-size: var(--text-sm);
    transition: border-color .15s, color .15s;
  }
  .external:hover { border-color: var(--accent); color: var(--focus); }
  @media (max-width: 56rem) {
    .header-inner { grid-template-columns: auto 1fr auto; gap: var(--space-4); }
    nav { justify-content: center; margin-left: 0; }
  }
  @media (max-width: 44rem) {
    .site-header { position: static; }
    .header-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2); padding-block: var(--space-2); }
    .header-brand :global(.lockup) { height: 1.1rem; }
    nav { width: 100%; order: 3; flex-wrap: wrap; gap: 0; margin-left: calc(-1 * var(--space-2)); }
    nav a { padding: var(--space-2); font-size: var(--text-xs); }
    nav a[aria-current]::after { left: var(--space-2); right: var(--space-2); }
    .external { min-height: 2rem; font-size: var(--text-xs); }
  }
</style>
