---
/** Shared primary navigation. A plain bar that stays at the top on every screen size. */
import { nav } from '../data/site';
import { url, isCurrent } from '../lib/url';
import BrandMark from './BrandMark.astro';
---
<header class="site-header">
  <div class="wrap header-inner">
    <BrandMark class="header-brand" />
    <nav aria-label="Primary navigation">
      {nav.map(item => <a href={url(item.href)} aria-current={isCurrent(Astro.url.pathname, item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-height);
    background: var(--surface);
  }
  /* The bar's lower edge dissolves into the page in the films' dither, as the bands do. */
  .site-header::after {
    content: ''; position: absolute; left: 0; right: 0; top: 100%; height: calc(var(--px) * 8);
    background: var(--surface); pointer-events: none; transform: scaleY(-1);
    -webkit-mask: var(--dither-edge) 0 0 / calc(var(--px) * 4) 100% repeat-x;
    mask: var(--dither-edge) 0 0 / calc(var(--px) * 4) 100% repeat-x;
  }
  .header-inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); }
  .header-brand { --h: 1rem; --lockup-word: var(--graphite); --lockup-mark: var(--graphite); }
  .header-brand:is(:hover, :focus-visible) { --lockup-mark: var(--accent); }
  nav { display: flex; align-items: center; gap: var(--space-8); font: var(--text-sm)/1 var(--font-mono); }
  nav a {
    padding-block: var(--space-2);
    border-bottom: var(--border) solid transparent;
    color: var(--secondary);
    text-decoration: none;
    transition: color .12s;
  }
  nav a:hover { color: var(--text); }
  nav a[aria-current] { color: var(--text); border-bottom-color: var(--accent); }
  @media (max-width: 30rem) {
    nav { gap: var(--space-4); font-size: var(--text-xs); }
  }
</style>
