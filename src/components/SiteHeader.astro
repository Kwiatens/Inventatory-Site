---
/** Shared primary navigation; it stays visible on narrow screens without JavaScript. */
import { nav } from '../data/site';
import { url, isCurrent } from '../lib/url';
import BrandMark from './BrandMark.astro';

const pages = nav.filter(item => !item.href.startsWith('https:'));
const external = nav.filter(item => item.href.startsWith('https:'));
---
<header class="site-header">
  <div class="wrap header-inner">
    <BrandMark class="header-brand" />
    <nav aria-label="Primary navigation">
      {pages.map(item => <a href={url(item.href)} aria-current={isCurrent(Astro.url.pathname, item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="header-meta">
      {external.map(item => <a class="external" href={item.href}>{item.label}<span aria-hidden="true"> ↗</span></a>)}
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    border-bottom: var(--border) solid var(--divider);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  /* Equal side columns keep the nav centred on the page. */
  .header-inner { min-height: var(--header-height); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-4); }
  /* A quiet graphite mark; on wide screens with a mouse it unfolds into the wordmark. */
  .header-brand { justify-self: start; --h: 1.5rem; --lockup-word: var(--muted); --lockup-mark: #5d6865; }
  .header-brand:is(:hover, :focus-visible) { --lockup-mark: var(--accent); }
  nav { display: flex; justify-content: center; gap: var(--space-1); min-width: 0; }
  nav a {
    position: relative; padding: var(--space-2) var(--space-4);
    color: var(--secondary); text-decoration: none; font: var(--text-sm)/1.5 var(--font-mono);
    transition: background .15s, color .15s;
  }
  nav a:hover { background: var(--hover); color: var(--text); }
  nav a[aria-current] { color: var(--text); }
  /* Active page: a row of pixel dashes, like the slots in the mark. */
  nav a[aria-current]::after {
    content: ''; position: absolute; left: var(--space-4); right: var(--space-4); bottom: 2px; height: 3px;
    background: repeating-linear-gradient(90deg, color-mix(in srgb, var(--muted) 60%, transparent) 0 3px, transparent 3px 5px);
  }
  .header-meta { justify-self: end; display: flex; align-items: center; gap: var(--space-4); font: var(--text-xs)/1.5 var(--font-mono); }
  .external {
    display: inline-flex; align-items: center; min-height: 2.125rem; padding: 0 var(--space-3);
    border: var(--border) solid var(--divider); color: var(--secondary); text-decoration: none; font-size: var(--text-sm);
    transition: border-color .15s, color .15s;
  }
  .external:hover { border-color: var(--accent); color: var(--focus); }
  /* Wide screens with a pointer: room kept for the unfolded wordmark so nothing moves. */
  @media (min-width: 64rem) { .header-inner { gap: var(--space-6); } }
  @media (min-width: 64rem) and (hover: hover) {
    .header-brand { min-width: calc(var(--h) * var(--expanded)); }
  }
  @media (max-width: 48rem) {
    nav { gap: 0; }
    nav a { padding: var(--space-2) var(--space-3); font-size: var(--text-xs); }
    nav a[aria-current]::after { left: var(--space-3); right: var(--space-3); }
    .external { min-height: 2rem; font-size: var(--text-xs); }
  }
  /* Phones: logo and GitHub on top, the page links on their own row. */
  @media (max-width: 32rem) {
    .site-header { position: static; }
    .header-inner { grid-template-columns: 1fr auto; row-gap: 0; padding-block: var(--space-2) 0; }
    nav { grid-row: 2; grid-column: 1 / -1; justify-content: flex-start; margin-left: calc(-1 * var(--space-3)); padding-block: var(--space-1); }
  }
</style>
