---
/**
 * Concept: the pixel-art film (lib/film/reel) as one player. One scan puts a part away; then a
 * board's BOM shows what the exact slot is for (see reel.ts). Under the picture: the loop's chapters,
 * each as long as its part of the loop with its own progress line; a click jumps to one. Plays
 * while on screen; with reduced motion it shows a poster frame until played.
 */
const label = 'Animation: the Scan R1 reads a vendor bag\'s label; you press A once; Inventatory on the PC fills in the part from the vendor and reserves slot R1-B3; parts go into a tube, its label prints and wraps the tube, and the tube drops into the rack. The cursor asks: But why is this useful? A circuit board\'s parts list prints out. The usual answer, Drawer 12 for every part, points into one drawer of identical bags; the cursor searches them, shakes its head and gives up. Inventatory gives every part its own slot in rack 1; the cursor goes straight to each one and nods. The six tubes are lifted out one by one, the 10K from R1-B3 first, and stand in a row as each line of the list is ticked. The cursor becomes the Inventatory logo.';
---
<figure class="film" data-reel>
  <div class="screen frame" data-screen>
    <canvas id="film-reel" role="img" aria-label={label} width="384" height="166"></canvas>
  </div>
  <figcaption class="transport" data-fit>
    <button type="button" class="key play" data-play aria-label="Pause"><span data-icon></span></button>
    <ol class="chapters" data-chapters aria-label="Chapters"></ol>
    <span class="time" data-time>0:00</span>
  </figcaption>
</figure>

<script>
  import { createReel, W, H, LOOP, POSTER, CHAPTERS } from '../../lib/film/reel';

  const pad = (n: number) => String(n).padStart(2, '0');
  const fmt = (ms: number) => `${Math.floor(ms / 60000)}:${pad(Math.floor(ms / 1000) % 60)}`;

  for (const root of document.querySelectorAll<HTMLElement>('[data-reel]')) {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const film = createReel(canvas);
    const screen = root.querySelector<HTMLElement>('[data-screen]')!;
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const list = root.querySelector<HTMLOListElement>('[data-chapters]')!;
    const time = root.querySelector<HTMLElement>('[data-time]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Whole-number scale when there is room, so every art pixel is the same size. On phones the
    // film is drawn at 2x, and a window follows the action (see follow): the whole film is too
    // wide to show at that size.
    const phone = window.matchMedia('(max-width: 40rem)');
    let avail = 0, target = 0, focus = W / 2;
    const fit = () => {
      if (phone.matches) {
        avail = screen.clientWidth;
        canvas.style.width = W * 2 + 'px'; canvas.style.height = H * 2 + 'px';
        return;
      }
      const inset = parseFloat(getComputedStyle(screen).paddingLeft) * 2;
      avail = screen.clientWidth - inset;
      const dpr = devicePixelRatio || 1;
      const k = Math.floor(avail * dpr / W);
      const css = k >= 2 ? (k * W) / dpr : avail;
      canvas.style.width = css + 'px'; canvas.style.height = css * H / W + 'px';
    };
    new ResizeObserver(fit).observe(screen);
    phone.addEventListener('change', fit);

    // The window looks at the middle of the lit pixels, and never past the film's edges. It is
    // read every third frame; tick eases the window towards it.
    const context = canvas.getContext('2d')!;
    let frame = 0;
    const follow = () => {
      if (!phone.matches || frame++ % 3) return;
      const { data } = context.getImageData(0, 0, W, H);
      let sum = 0, weight = 0;
      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
        const p = (y * W + x) * 4;
        if (data[p] * .2126 + data[p + 1] * .7152 + data[p + 2] * .0722 > 40) { sum += x; weight++; }
      }
      const cx = weight ? sum / weight : W / 2;
      // Smooth the focus itself, so one busy frame does not swing the window.
      focus += (cx - focus) * .05;
      target = Math.max(0, Math.min(W * 2 - avail, focus * 2 - avail / 2));
    };

    let t = reduced.matches ? POSTER : 0, playing = !reduced.matches, visible = false, last = performance.now();
    // Chapters: each as long as its part of the loop; a click starts it.
    const marks = [...CHAPTERS.map(([, at]) => at), LOOP];
    const parts = CHAPTERS.map(([name, at], i) => {
      const li = document.createElement('li');
      li.style.flexGrow = String(marks[i + 1] - at);
      li.innerHTML = `<button type="button"><span class="n">${pad(i + 1)}</span>${name}</button><i class="fill"></i>`;
      li.querySelector('button')!.addEventListener('click', () => { t = at + 1; draw(); });
      list.append(li);
      return li;
    });
    const draw = () => {
      film.render(t);
      follow();
      parts.forEach((li, i) => {
        const a = marks[i], b = marks[i + 1];
        li.style.setProperty('--p', String(Math.max(0, Math.min(1, (t - a) / (b - a)))));
        li.classList.toggle('now', t >= a && t < b);
      });
      time.textContent = `${fmt(t)} / ${fmt(LOOP)}`;
    };
    const setPlaying = (on: boolean) => {
      playing = on;
      play.setAttribute('aria-label', on ? 'Pause' : 'Play');
      play.dataset.state = on ? 'playing' : 'paused';
    };
    play.addEventListener('click', () => setPlaying(!playing));

    new IntersectionObserver(([e]) => { visible = e.isIntersecting; last = performance.now(); }, { threshold: .3 }).observe(screen);

    const tick = (now: number) => {
      if (playing && visible && !document.hidden) { t = (t + Math.min(100, now - last)) % LOOP; draw(); }
      if (phone.matches) screen.scrollLeft += Math.max(-1.5, Math.min(1.5, (target - screen.scrollLeft) * .03));
      last = now;
      requestAnimationFrame(tick);
    };
    setPlaying(playing);
    fit();
    draw();
    requestAnimationFrame(tick);
  }
</script>

<style>
  .film { margin: 0; }
  /* The screen reaches two art pixels past the column each side, so the film inside it gets the
     column's full width (three times its own) and the frame sits just outside the picture. */
  .screen.frame { --frame: var(--divider); --fill: var(--canvas); display: flex; justify-content: center; margin-inline: calc(var(--px) * -2); padding: calc(var(--px) * 2); }
  canvas { display: block; image-rendering: pixelated; image-rendering: crisp-edges; }
  /* Under the picture: play/pause, a key off the Scan R1's keypad, then the chapters and the time. */
  .transport { display: flex; align-items: center; gap: var(--space-4); margin-top: var(--space-4); }
  .key.play { flex: none; width: 2.5rem; min-height: 2.5rem; padding: 0; }
  /* Pixel icons: two bars to pause, a stepped triangle to play. */
  .play [data-icon] { width: 10px; height: 10px; background:
      linear-gradient(currentColor, currentColor) 1px 0 / 3px 10px no-repeat,
      linear-gradient(currentColor, currentColor) 6px 0 / 3px 10px no-repeat; }
  .play[data-state="paused"] [data-icon] { background:
      linear-gradient(currentColor, currentColor) 1px 0 / 2px 10px no-repeat,
      linear-gradient(currentColor, currentColor) 3px 1px / 2px 8px no-repeat,
      linear-gradient(currentColor, currentColor) 5px 2px / 2px 6px no-repeat,
      linear-gradient(currentColor, currentColor) 7px 4px / 2px 2px no-repeat; }
  /* Chapters: each its own progress on a pixel line. */
  .chapters { flex: 1; min-width: 0; display: flex; gap: var(--px); margin: 0; padding: 0; list-style: none; }
  .chapters :global(li) { position: relative; flex-basis: 0; min-width: 0; margin: 0; padding-top: var(--space-3); }
  .chapters :global(li)::before, .chapters :global(.fill) { content: ''; position: absolute; left: 0; top: 0; height: var(--px); }
  .chapters :global(li)::before { right: 0; background: var(--divider); }
  .chapters :global(.fill) { width: calc(var(--p, 0) * 100%); background: var(--accent); }
  .chapters :global(button) { display: flex; gap: var(--space-2); width: 100%; padding: 0; border: 0; background: none; color: var(--muted); font: var(--text-xs)/1.3 var(--font-mono); text-align: left; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chapters :global(.n) { color: var(--divider); }
  .chapters :global(li.now button), .chapters :global(button:hover) { color: var(--text); }
  .chapters :global(li.now .n) { color: var(--accent); }
  .time { flex: none; color: var(--muted); font: var(--text-xs)/1 var(--font-mono); font-variant-numeric: tabular-nums; }
  /* Phones: the film runs edge to edge at 2x, the window moves with the action, and the chapters
     keep only their lines (still a tap target each). */
  @media (max-width: 40rem) {
    .screen.frame { margin-inline: calc(var(--gutter) * -1); padding: 0; justify-content: flex-start; overflow: hidden; }
    canvas { flex: none; }
    .chapters :global(button) { font-size: 0; gap: 0; min-height: 1.5rem; }
    .chapters :global(.n) { display: none; }
  }
</style>
