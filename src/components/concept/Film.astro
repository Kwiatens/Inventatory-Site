---
/**
 * Concept: the pixel-art film (lib/film/reel) as one player. One scan puts a part away; then a
 * board's BOM shows what the exact slot is for (see reel.ts). Under the picture: one timeline with a
 * segment per film, named from home.json (click or drag to scrub, arrow keys step chapters). Plays
 * while on screen; with reduced motion it shows a poster frame until played.
 */
import { film } from '../../data/home';
const label = 'Animation: the Scan R1 reads a vendor bag\'s label; you press A once; Inventatory on the PC fills in the part from the vendor and reserves slot R1-B3; parts go into a tube, its label prints and wraps the tube, and the tube drops into the rack. The cursor asks: But why is this useful? A circuit board\'s parts list prints out. The usual answer, Drawer 12 for every part, points into one drawer of identical bags; the cursor searches them, shakes its head and gives up. Inventatory gives every part its own slot in rack 1; the cursor goes straight to each one and nods. The six tubes are lifted out one by one, the 10K from R1-B3 first, and stand in a row as each line of the list is ticked. The cursor becomes the Inventatory logo.';
---
<figure class="film" data-reel>
  <div class="screen" data-screen>
    <canvas id="film-reel" role="img" aria-label={label} width="384" height="166"></canvas>
  </div>
  <figcaption class="under" data-fit>
    <div class="bar">
      <button type="button" class="play key" data-play aria-label="Pause"><span data-icon></span></button>
      <div class="reel">
        <div class="track" data-track role="slider" tabindex="0" aria-label="Position in the animation" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          {film.names.map(name => (
            <div class="seg" data-seg><span class="name">{name}</span><div class="fill" data-fill></div></div>
          ))}
        </div>
      </div>
    </div>
  </figcaption>
</figure>

<script>
  import { createReel, W, H, LOOP, POSTER, CHAPTERS, FILMS } from '../../lib/film/reel';

  for (const root of document.querySelectorAll<HTMLElement>('[data-reel]')) {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const film = createReel(canvas);
    const screen = root.querySelector<HTMLElement>('[data-screen]')!;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const segs = [...root.querySelectorAll<HTMLElement>('[data-seg]')];
    const fills = segs.map(seg => seg.querySelector<HTMLElement>('[data-fill]')!);
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Whole-number scale when there is room, so every art pixel is the same size; the bar
    // takes the film's width. On phones the film is drawn at 2x, and a window follows the action
    // (see follow): the whole film is too wide to show at that size.
    const phone = window.matchMedia('(max-width: 40rem)');
    let avail = 0, target = 0, focus = W / 2;
    const fit = () => {
      avail = screen.clientWidth;
      // A segment is as long as its film, except on phones, where the segments are equal.
      segs.forEach((seg, k) => { seg.style.flexGrow = String(phone.matches ? 1 : FILMS[k].end - FILMS[k].start); });
      if (phone.matches) {
        canvas.style.width = W * 2 + 'px'; canvas.style.height = H * 2 + 'px';
        root.style.setProperty('--film-w', avail + 'px');
        return;
      }
      const dpr = devicePixelRatio || 1;
      const k = Math.floor(avail * dpr / W);
      const css = k >= 2 ? (k * W) / dpr : avail;
      canvas.style.width = css + 'px'; canvas.style.height = css * H / W + 'px';
      root.style.setProperty('--film-w', css + 'px');
    };
    new ResizeObserver(fit).observe(screen);
    phone.addEventListener('change', fit);

    // The window looks at the middle of the lit pixels, and never past the film's edges. It is
    // read every third frame; tick eases the window towards it.
    const context = canvas.getContext('2d')!;
    let frame = 0;
    const follow = () => {
      if (!phone.matches || frame++ % 3) return;
      const { data } = context.getImageData(0, 0, W, H);
      let sum = 0, weight = 0;
      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
        const p = (y * W + x) * 4;
        if (data[p] * .2126 + data[p + 1] * .7152 + data[p + 2] * .0722 > 40) { sum += x; weight++; }
      }
      const cx = weight ? sum / weight : W / 2;
      // Smooth the focus itself, so one busy frame does not swing the window.
      focus += (cx - focus) * .05;
      target = Math.max(0, Math.min(W * 2 - avail, focus * 2 - avail / 2));
    };

    let t = reduced.matches ? POSTER : 0, playing = !reduced.matches, visible = false, last = performance.now();
    const draw = () => {
      film.render(t);
      follow();
      // The film playing now is the open segment: it carries the playhead and its name.
      const current = FILMS.findIndex(f => t >= f.start && t < f.end);
      segs.forEach((seg, k) => {
        const f = FILMS[k];
        seg.classList.toggle('open', k === current);
        fills[k].style.width = Math.max(0, Math.min(1, (t - f.start) / (f.end - f.start))) * 100 + '%';
      });
      track.setAttribute('aria-valuenow', String(Math.round(t / LOOP * 100)));
    };
    const setPlaying = (on: boolean) => {
      playing = on;
      play.setAttribute('aria-label', on ? 'Pause' : 'Play');
      play.dataset.state = on ? 'playing' : 'paused';
    };
    play.addEventListener('click', () => setPlaying(!playing));
    // The pointer picks the moment under it: its place along the nearest film's segment.
    const seek = (clientX: number) => {
      let k = 0, gap = Infinity;
      segs.forEach((seg, i) => {
        const r = seg.getBoundingClientRect();
        const d = clientX < r.left ? r.left - clientX : clientX > r.right ? clientX - r.right : 0;
        if (d < gap) { gap = d; k = i; }
      });
      const r = segs[k].getBoundingClientRect();
      const f = FILMS[k];
      t = f.start + Math.max(0, Math.min(.999, (clientX - r.left) / r.width)) * (f.end - f.start);
      draw();
    };
    track.addEventListener('pointerdown', (e) => { seek(e.clientX); track.setPointerCapture(e.pointerId); });
    track.addEventListener('pointermove', (e) => { if (track.hasPointerCapture(e.pointerId)) seek(e.clientX); });
    // Arrow keys step chapters.
    track.addEventListener('keydown', (e) => {
      const i = CHAPTERS.findLastIndex(c => c <= t);
      if (e.key === 'ArrowRight') t = CHAPTERS[Math.min(CHAPTERS.length - 1, i + 1)];
      else if (e.key === 'ArrowLeft') t = CHAPTERS[Math.max(0, i - (t - CHAPTERS[i] < 800 ? 1 : 0))];
      else if (e.key === ' ') setPlaying(!playing);
      else return;
      e.preventDefault(); draw();
    });

    // 0.5s persistence check: pause when out of view, resume when scrolled back in view
    let visibilityTimer: ReturnType<typeof setTimeout> | null = null;
    new IntersectionObserver(([e]) => {
      if (visibilityTimer) clearTimeout(visibilityTimer);
      const inView = e.isIntersecting;
      visibilityTimer = setTimeout(() => {
        if (visible !== inView) {
          visible = inView;
          last = performance.now();
        }
      }, 500);
    }, { threshold: .25 }).observe(screen);

    const tick = (now: number) => {
      if (playing && visible && !document.hidden) {
        t += Math.min(100, now - last);
        if (t >= LOOP) t -= LOOP;
        draw();
      }
      if (phone.matches) screen.scrollLeft += Math.max(-1.5, Math.min(1.5, (target - screen.scrollLeft) * .03));
      last = now;
      requestAnimationFrame(tick);
    };
    setPlaying(playing);
    fit();
    draw();
    requestAnimationFrame(tick);
  }
</script>

<style>
  .film { margin: 0; }
  .film [data-fit] { width: var(--film-w, 100%); max-width: 100%; margin-inline: auto; }
  .screen { display: flex; justify-content: center; }
  canvas { display: block; image-rendering: pixelated; image-rendering: crisp-edges; }
  canvas[hidden] { display: none; }
  /* Under the picture: the controls on the film's own grid, one art pixel (--px) thick, no
     rounding. */
  .under { margin-top: var(--space-4); }
  .bar { display: flex; align-items: center; gap: var(--space-4); }
  /* Play/pause is a key off the Scan R1's keypad. */
  .play { flex: none; width: 2.25rem; min-height: 2.25rem; padding: 0; }
  /* Pixel icons: two bars to pause, a stepped triangle to play. */
  .play [data-icon] { width: 10px; height: 10px; background:
      linear-gradient(var(--secondary), var(--secondary)) 1px 0 / 3px 10px no-repeat,
      linear-gradient(var(--secondary), var(--secondary)) 6px 0 / 3px 10px no-repeat; }
  .play[data-state="paused"] [data-icon] { background:
      linear-gradient(var(--secondary), var(--secondary)) 1px 0 / 2px 10px no-repeat,
      linear-gradient(var(--secondary), var(--secondary)) 3px 1px / 2px 8px no-repeat,
      linear-gradient(var(--secondary), var(--secondary)) 5px 2px / 2px 6px no-repeat,
      linear-gradient(var(--secondary), var(--secondary)) 7px 4px / 2px 2px no-repeat; }
  /* The reel: one timeline, a segment per film. Each segment is as long as its film, with a gap of
     four art pixels between them, and its name sits above the line in the mono type the labels use. */
  .reel { flex: 1; min-width: 0; }
  .track { position: relative; display: flex; gap: calc(var(--px) * 4); height: 2.25rem; cursor: pointer; touch-action: none; }
  .seg { position: relative; flex: 1 1 0; min-width: 0; height: 100%; }
  .name { position: absolute; left: 0; top: 0; font-family: var(--font-mono); font-size: var(--text-xs); line-height: 1; white-space: nowrap; color: var(--muted); }
  .seg.open .name { color: var(--text); }
  .seg::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: var(--px); margin-top: calc(var(--px) / -2); background: var(--divider); }
  .fill { position: absolute; left: 0; top: 50%; height: var(--px); margin-top: calc(var(--px) / -2); background: var(--accent); }
  /* The playhead: one block, twice the line's height, on the open film's segment only. */
  .open .fill::after { content: ''; position: absolute; right: calc(var(--px) * -1); top: calc(var(--px) * -1.5); width: calc(var(--px) * 2); height: calc(var(--px) * 4); background: var(--focus); }
  .track:focus-visible { outline-offset: 2px; }
  /* Phones: the film runs edge to edge at 2x, and the window moves with the action. */
  @media (max-width: 40rem) {
    .screen { margin-inline: calc(var(--gutter) * -1); justify-content: flex-start; overflow: hidden; }
    canvas { flex: none; }
    /* The segments are equal here, so only the open film is named. */
    .name { visibility: hidden; }
    .seg.open .name { visibility: visible; }
  }
</style>
