---
/** Original character artwork and gradient, with a readable narrow-screen fallback. */
import { logoRows } from '../data/logo';
const colors = logoRows.map((_, row) => {
  const a = [88, 185, 176], b = [185, 231, 221];
  return 'rgb(' + a.map((value, i) => value + Math.trunc((b[i] - value) * row / 5)).join(',') + ')';
});
---
<div class="brand" role="img" aria-label="Inventatory">
  <span class="ascii" aria-hidden="true">{logoRows.map((row, i) => <span style={{ color: colors[i] }}>{row}</span>)}</span>
  <span class="compact" aria-hidden="true">Inventatory</span>
</div>
<style>
  .brand { margin: 0; font-weight: 400; }
  .ascii { display: block; font-family: Consolas, 'Cascadia Mono', 'DejaVu Sans Mono', monospace; font-size: clamp(.48rem, .7vw, .72rem); line-height: 1.06; letter-spacing: 0; font-variant-ligatures: none; }
  .ascii > span { white-space: pre; display: block; }
  .compact { display: none; color: var(--accent); font-family: var(--font-mono); font-size: var(--text-h1); }
  @media (max-width: 40rem) { .ascii { display: none; } .compact { display: block; } }
</style>
