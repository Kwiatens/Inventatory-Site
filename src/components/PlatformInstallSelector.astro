---
import { site } from '../data/site';
import { url } from '../lib/url';
import Mascot from './Mascot.astro';

interface Props {
  id: string;
  /** Shows the mascot beside each Copy button. The homepage does; the download page does not. */
  mascot?: boolean;
}

const { id, mascot = false } = Astro.props;
const releaseBase = site.releases + '/latest/download';
const windowsCommand = 'curl.exe -fL "' + releaseBase + '/Install-Inventatory.ps1" -o "%TEMP%\\Install-Inventatory.ps1" && powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%TEMP%\\Install-Inventatory.ps1" && del /q "%TEMP%\\Install-Inventatory.ps1"';
const linuxCommand = [
  'mkdir -p "$HOME/.cache/inventatory-installer"',
  'cd "$HOME/.cache/inventatory-installer"',
  'curl -fL -O "' + releaseBase + '/Inventatory-linux-x64.tar.gz"',
  'curl -fL -O "' + releaseBase + '/SHA256SUMS-linux.txt"',
  'curl -fL -O "' + releaseBase + '/Install-Inventatory.sh"',
  'chmod +x Install-Inventatory.sh',
  './Install-Inventatory.sh',
];
const linuxCopy = linuxCommand.join(' && ');
---
<section id={id} class="install" aria-labelledby={id + '-title'}>
  <h2 id={id + '-title'} class="sr-only">Install Inventatory</h2>
  <p class="install-lead">Choose Windows or Linux. The installer fetches the latest stable release and checks the package before it installs anything.</p>

  <fieldset class="platform">
    <legend class="sr-only">Choose your operating system</legend>
    <div class="platform-tabs">
      <input class="platform-radio" type="radio" name={id + '-platform'} id={id + '-windows'} value="windows" checked />
      <label class="platform-tab" for={id + '-windows'}>Windows <small>x64</small></label>
      <input class="platform-radio" type="radio" name={id + '-platform'} id={id + '-linux'} value="linux" />
      <label class="platform-tab" for={id + '-linux'}>Linux <small>Ubuntu 24.04</small></label>
    </div>

    <!-- Both panels share one grid cell, so the box keeps its height whichever is open. -->
    <div class="platform-panels">
      <section class="platform-panel" data-platform-panel="windows" aria-labelledby={id + '-windows-title'}>
        <h3 id={id + '-windows-title'} class="sr-only">Windows · x64</h3>
        <p class="platform-lead">Open Command Prompt and paste the command. Then follow the installer.</p>
        <div class="command">
          <div class="command-bar">
            <span class="command-shell">Command Prompt</span>
            <div class="command-tools">
              {mascot && <Mascot size="1.125rem" />}
            <button type="button" class="copy-button" aria-label="Copy install command" data-copy={windowsCommand}>
              <span class="copy-label">Copy</span>
            </button>
            </div>
          </div>
          <pre><code>{windowsCommand}</code></pre>
        </div>
      </section>

      <section class="platform-panel" data-platform-panel="linux" aria-labelledby={id + '-linux-title'}>
        <h3 id={id + '-linux-title'} class="sr-only">Ubuntu 24.04 LTS · x86-64</h3>
        <p class="platform-lead">Paste the command into a terminal. The installer puts Inventatory in <code>~/.local/bin/inventatory</code>.</p>
        <div class="command">
          <div class="command-bar">
            <span class="command-shell">Terminal</span>
            <div class="command-tools">
              {mascot && <Mascot size="1.125rem" />}
            <button type="button" class="copy-button" aria-label="Copy install command" data-copy={linuxCopy}>
              <span class="copy-label">Copy</span>
            </button>
            </div>
          </div>
          <pre><code>{linuxCopy}</code></pre>
        </div>
        <p class="platform-note">Missing runtime libraries? <a class="go" href={url('/docs/getting-started/installation/#requirements')}>See the requirements</a></p>
      </section>
    </div>
  </fieldset>

  <div class="install-foot"><a class="out" href={site.releases}>All releases</a></div>
</section>

<script>
  document.addEventListener('click', async (e) => {
    const button = (e.target as Element).closest<HTMLButtonElement>('.copy-button');
    if (!button) return;

    const text = button.getAttribute('data-copy') || button.closest('.platform-panel')?.querySelector('code')?.textContent?.trim() || '';
    if (!text) return;

    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
      } else {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        const copied = document.execCommand('copy');
        textArea.remove();
        if (!copied) throw new Error('The browser refused the copy');
      }

      button.classList.add('copied');
      const label = button.querySelector<HTMLElement>('.copy-label');
      if (label) label.textContent = 'Copied';
      const mascotEl = button.closest('.command')?.querySelector<SVGElement>('.mascot');
      if (mascotEl) {
        mascotEl.dataset.play = 'none';
        void mascotEl.getBoundingClientRect();
        mascotEl.dataset.play = 'nod';
      }

      setTimeout(() => {
        button.classList.remove('copied');
        if (label) label.textContent = 'Copy';
      }, 2000);
    } catch (err) {
      console.error('Failed to copy install command', err);
    }
  });
</script>

<style>
  .install { padding-block: var(--space-16) var(--space-12); border-top: var(--border) solid var(--divider); }
  .install-lead { max-width: 60ch; color: var(--secondary); font-size: var(--text-lead); line-height: 1.6; }

  .platform { min-width: 0; margin: var(--space-8) 0 0; padding: 0; border: 0; }

  /* Tabs are text with a bar under the open one; the rule underneath is the panel's top edge. */
  .platform-tabs { display: flex; gap: var(--space-8); border-bottom: var(--border) solid var(--divider); }
  .platform-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .platform-tab {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: calc(-1 * var(--border));
    padding: var(--space-3) 0;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    transition: color .12s, border-color .12s;
  }
  .platform-tab small { font: var(--text-xs)/1 var(--font-mono); color: inherit; }
  .platform-tab:hover { color: var(--text); }
  .platform-radio:checked + .platform-tab { color: var(--text); border-bottom-color: var(--accent); }
  .platform-radio:focus-visible + .platform-tab { outline: var(--focus-width) solid var(--focus); outline-offset: 2px; }

  .platform-panels { display: grid; padding-top: var(--space-8); }
  .platform-panel { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
  .platform-lead { max-width: 60ch; color: var(--secondary); line-height: 1.6; }
  .platform-lead code { color: var(--text); font-size: var(--text-sm); }

  .command { min-width: 0; border: var(--border) solid var(--divider); background: var(--surface); }
  .command-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border-bottom: var(--border) solid var(--divider);
  }
  .command-tools { display: flex; align-items: center; gap: var(--space-3); }
  .command-shell { color: var(--muted); font: 500 var(--text-xs)/1 var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }
  .copy-button {
    min-height: 2rem;
    padding: 0 var(--space-3);
    border: var(--border) solid var(--divider);
    background: transparent;
    color: var(--secondary);
    font: 500 var(--text-xs)/1 var(--font-mono);
    cursor: pointer;
    transition: color .12s, border-color .12s;
  }
  .copy-button:hover { color: var(--text); border-color: var(--muted); }
  .copy-button:focus-visible { outline: var(--focus-width) solid var(--focus); outline-offset: 2px; }
  .copy-button.copied { color: var(--success); border-color: var(--success); }

  /* The whole command wraps inside the box: nothing is cut off, and copying gives one line. */
  .command pre { margin: 0; padding: var(--space-4); color: var(--focus); font: var(--text-sm)/1.7 var(--font-mono); white-space: pre-wrap; overflow-wrap: anywhere; }
  .command code { color: inherit; }

  .platform-note { color: var(--muted); font-size: var(--text-sm); }
  .platform-note a { text-decoration: none; }
  .install-foot { display: flex; justify-content: flex-end; margin-top: var(--space-4); font: var(--text-sm)/1.5 var(--font-mono); }
  .install-foot a { text-decoration: none; }

  /* Both panels are in one cell; the hidden one still takes its space, so the box never jumps. */
  @supports selector(.platform:has(input:checked)) {
    .platform-panel { grid-area: 1 / 1; }
    .platform:has(.platform-radio[value="windows"]:checked) [data-platform-panel="linux"],
    .platform:has(.platform-radio[value="linux"]:checked) [data-platform-panel="windows"] { visibility: hidden; }
  }

  @media (max-width: 30rem) {
    .platform-tabs { gap: var(--space-6); }
    .command pre { padding: var(--space-3); }
  }
</style>
