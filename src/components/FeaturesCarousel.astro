---
/**
 * Horizontal scroll-snap carousel with clickable dots, arrow navigation,
 * and auto-advance. Pure CSS layout + minimal vanilla JS.
 * Respects prefers-reduced-motion by disabling auto-advance.
 */
import { carouselSlides } from '../data/site';
import { url } from '../lib/url';
---
<section class="carousel-section" aria-labelledby="carousel-heading">
  <h2 id="carousel-heading" class="sr-only">Key features</h2>

  <div class="carousel-viewport" tabindex="0" aria-label="Features carousel" role="region">
    <button class="carousel-arrow carousel-arrow--prev" aria-label="Previous slide" data-dir="-1">‹</button>
    <button class="carousel-arrow carousel-arrow--next" aria-label="Next slide" data-dir="1">›</button>

    <div class="carousel-track" id="carousel-track">
      {carouselSlides.map((slide, i) => (
        <a class="carousel-slide" href={url(slide.href)} data-index={i} aria-label={slide.title}>
          <div class="slide-image-wrap">
            {slide.image
              ? <img src={url(slide.image)} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
              : <div class="slide-placeholder" aria-hidden="true"></div>}
          </div>
          <div class="slide-caption">
            <span class="slide-title">{slide.title}</span>
            <span class="slide-text">{slide.caption}</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <div class="carousel-dots" role="tablist" aria-label="Carousel navigation">
    {carouselSlides.map((slide, i) => (
      <button
        class={`carousel-dot${i === 0 ? ' active' : ''}`}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-label={`Go to ${slide.title}`}
        data-index={i}
      ></button>
    ))}
  </div>
</section>

<style>
  .carousel-section {
    padding-block: var(--space-16);
    border-top: var(--border) solid var(--divider);
  }

  .carousel-viewport {
    position: relative;
    width: min(var(--width), calc(100% - var(--gutter) * 2));
    margin-inline: auto;
    overflow: hidden;
    border-radius: 6px;
  }

  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar { display: none; }

  .carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--secondary);
    background: var(--surface);
    border: var(--border) solid var(--divider);
    border-radius: 6px;
    overflow: hidden;
    transition: box-shadow 0.2s ease;
  }
  .carousel-slide:hover {
    box-shadow: 0 0 0 1px var(--accent);
  }

  .slide-image-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--canvas);
  }
  .slide-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-placeholder {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      -45deg,
      var(--surface),
      var(--surface) 10px,
      var(--raised) 10px,
      var(--raised) 20px
    );
    opacity: 0.5;
  }

  .slide-caption {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .slide-title {
    font: 500 var(--text-base)/1.4 var(--font-mono);
    color: var(--focus);
  }
  .slide-text {
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* Navigation arrows */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    background: var(--canvas);
    color: var(--text);
    border: var(--border) solid var(--divider);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    font-size: 1.25rem;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s ease, background 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .carousel-arrow:hover { opacity: 1; background: var(--surface); }
  .carousel-arrow--prev { left: var(--space-4); }
  .carousel-arrow--next { right: var(--space-4); }

  /* Dots */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .carousel-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: var(--border) solid var(--divider);
    background: var(--surface);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .carousel-dot.active,
  .carousel-dot:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 48rem) {
    .carousel-arrow { display: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const track = document.getElementById('carousel-track');
    if (!track) return;

    const slides = track.querySelectorAll('.carousel-slide');
    const dots = document.querySelectorAll('.carousel-dot');
    const arrows = document.querySelectorAll('.carousel-arrow');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function goTo(index: number) {
      const n = slides.length;
      current = ((index % n) + n) % n;
      (slides[current] as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      updateDots();
    }

    function updateDots() {
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === current);
        dot.setAttribute('aria-selected', i === current ? 'true' : 'false');
      });
    }

    // IntersectionObserver to detect which slide is visible (for swipe/scroll)
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const idx = Number((entry.target as HTMLElement).dataset.index);
          if (!isNaN(idx)) { current = idx; updateDots(); }
        }
      });
    }, { root: track, threshold: 0.6 });

    slides.forEach(slide => observer.observe(slide));

    // Dot clicks
    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        const idx = Number((dot as HTMLElement).dataset.index);
        if (!isNaN(idx)) goTo(idx);
        restartTimer();
      });
    });

    // Arrow clicks
    arrows.forEach(arrow => {
      arrow.addEventListener('click', () => {
        const dir = Number((arrow as HTMLElement).dataset.dir);
        goTo(current + dir);
        restartTimer();
      });
    });

    // Auto-advance
    function startTimer() {
      if (prefersReduced.matches) return;
      timer = setInterval(() => goTo(current + 1), 5000);
    }
    function stopTimer() {
      if (timer) { clearInterval(timer); timer = null; }
    }
    function restartTimer() { stopTimer(); startTimer(); }

    // Pause on hover/focus
    const section = track.closest('.carousel-viewport');
    if (section) {
      section.addEventListener('mouseenter', stopTimer);
      section.addEventListener('mouseleave', startTimer);
      section.addEventListener('focusin', stopTimer);
      section.addEventListener('focusout', startTimer);
    }

    prefersReduced.addEventListener('change', () => {
      if (prefersReduced.matches) stopTimer(); else startTimer();
    });

    startTimer();
  });
</script>
