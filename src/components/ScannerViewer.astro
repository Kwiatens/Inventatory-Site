---
/**
 * Interactive 3D viewer for the Scan R1 scanner using Google's <model-viewer>.
 * Falls back to a poster image when no 3D model is provided.
 * The script tag is loaded from a CDN; no npm dependency needed.
 */
import { media } from '../data/site';
import { url } from '../lib/url';
const hasModel = !!media.scannerModel;
const hasPoster = !!media.scannerModelPoster;
---
<div class="scanner-viewer">
  {hasModel ? (
    <model-viewer
      src={url(media.scannerModel)}
      poster={hasPoster ? url(media.scannerModelPoster) : undefined}
      alt="Interactive 3D view of the Inventatory Scan R1 handheld scanner"
      auto-rotate
      camera-controls
      interaction-prompt="auto"
      shadow-intensity="0.8"
      environment-image="neutral"
      loading="lazy"
      style="width: 100%; aspect-ratio: 1 / 1; background: transparent;"
    ></model-viewer>
  ) : hasPoster ? (
    <img
      class="scanner-poster"
      src={url(media.scannerModelPoster)}
      alt="Inventatory Scan R1 handheld scanner"
      loading="lazy"
    />
  ) : (
    <div class="scanner-placeholder" aria-hidden="true">
      <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="25" y="8" width="30" height="55" rx="4" />
        <rect x="31" y="14" width="18" height="12" rx="2" />
        <line x1="40" y1="34" x2="40" y2="42" />
        <circle cx="40" cy="50" r="4" />
        <line x1="20" y1="68" x2="60" y2="68" />
        <line x1="25" y1="72" x2="55" y2="72" />
      </svg>
      <span>3D model coming soon</span>
    </div>
  )}
</div>

{hasModel && (
  <script is:inline type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
)}

<style>
  .scanner-viewer {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 20rem;
  }

  .scanner-poster {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .scanner-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 22rem;
    border: var(--border) dashed var(--divider);
    border-radius: 12px;
    color: var(--muted);
    font: var(--text-sm)/1.5 var(--font-mono);
    background: var(--surface);
  }
  .scanner-placeholder svg {
    width: 5rem;
    height: 5rem;
    opacity: 0.5;
  }
</style>
