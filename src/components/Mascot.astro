---
/**
 * The project mascot: the chevron of the ›I mark, acting. Two poses. Rest is the logo's chevron
 * and stem. Point turns the chevron into a down arrow, with its eye (the cell in the arrow's mouth)
 * lit in the accent colour. Geometry is taken from branding/inventatory-mark.svg (one cell = 100
 * units); the dot is left out, as in the header logo.
 *
 * `play` runs one stepped sequence and then rests: 'lost' shakes the arrow (page not found), 'nod'
 * dips the chevron once (a copy succeeded). Nothing loops. Reduced motion shows the still pose.
 */
interface Props {
  pose?: 'rest' | 'point';
  play?: 'none' | 'lost' | 'nod';
  size?: string;
}
const { pose = 'rest', play = 'none', size = '36px' } = Astro.props;
---
<svg
  class="mascot"
  data-pose={pose}
  data-play={play}
  style={{ '--mascot-size': size }}
  viewBox="0 300 600 600"
  aria-hidden="true"
  focusable="false"
  shape-rendering="crispEdges"
>
  <rect class="stem" x="400" y="300" width="200" height="600" />
  <g class="body">
    <g class="rest-pose">
      <rect x="0" y="350" width="100" height="100" />
      <rect x="100" y="450" width="100" height="100" />
      <rect x="200" y="550" width="100" height="100" />
      <rect x="100" y="650" width="100" height="100" />
      <rect x="0" y="750" width="100" height="100" />
    </g>
    <g class="point-pose">
      <rect x="100" y="350" width="100" height="100" />
      <rect x="100" y="450" width="100" height="100" />
      <rect x="0" y="550" width="100" height="100" />
      <rect x="200" y="550" width="100" height="100" />
      <rect x="100" y="650" width="100" height="100" />
      <rect class="eye" x="100" y="550" width="100" height="100" />
    </g>
  </g>
</svg>

<style>
  .mascot {
    display: block;
    flex: none;
    width: var(--mascot-size, 36px);
    height: var(--mascot-size, 36px);
    overflow: visible;
  }
  .mascot rect { fill: var(--graphite); }
  .mascot .eye { fill: var(--accent); }

  .point-pose { display: none; }
  .mascot[data-pose="point"] .point-pose { display: inline; }
  .mascot[data-pose="point"] .rest-pose { display: none; }

  /* Six swings of 105 ms each, then upright: 630 ms, stepped (no easing). */
  @keyframes mascot-shake {
    0% { transform: translateX(-100px); }
    16.67% { transform: translateX(100px); }
    33.33% { transform: translateX(-100px); }
    50% { transform: translateX(100px); }
    66.67% { transform: translateX(-100px); }
    83.33% { transform: translateX(100px); }
    100% { transform: translateX(0); }
  }
  /* One dip of one cell: 120 ms down, 120 ms back. The stem never moves. */
  @keyframes mascot-nod {
    0% { transform: translateY(0); }
    50% { transform: translateY(100px); }
    100% { transform: translateY(0); }
  }
  .mascot[data-play="lost"] .body { animation: mascot-shake 630ms steps(1, end) 1 both; }
  .mascot[data-play="nod"] .rest-pose { animation: mascot-nod 240ms steps(1, end) 1 both; }

  @media (prefers-reduced-motion: reduce) {
    .mascot[data-play] .body,
    .mascot[data-play] .rest-pose { animation: none !important; }
  }
</style>
