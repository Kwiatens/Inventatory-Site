---
import { site } from '../data/site';
import { url } from '../lib/url';
import Lockup from './Lockup.astro';
---
<footer class="wrap site-footer">
  <div class="footer-signature">
    <div class="footer-wordmark"><Lockup shadow={false} /></div>
    <p>Local electronic component inventory</p>
  </div>
  <nav aria-label="Footer links">
    <a href={url('/docs/resources/')}>Contribute</a>
    <a href={site.repository + '/issues'}>Report an issue</a>
    <a href={site.repository + '/blob/main/LICENSE.md'}>GPL-3.0-only</a>
  </nav>
</footer>
<style>
  .site-footer {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-6);
    padding-block: var(--space-8);
    border-top: var(--border) solid var(--divider);
    font: var(--text-xs)/1.7 var(--font-mono);
  }
  .footer-signature p { margin-top: var(--space-2); color: var(--muted); }
  .footer-wordmark { width: min(100%, 15rem); opacity: .85; animation: footer-mark-in 480ms ease-out both; }
  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-4); }
  nav a { color: var(--muted); text-decoration: none; transition: color 180ms ease; }
  nav a:hover { color: var(--focus); }
  @keyframes footer-mark-in {
    from { opacity: 0; transform: translateY(.35rem); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (max-width: 48rem) {
    .site-footer { grid-template-columns: 1fr; align-items: start; }
    nav { justify-content: flex-start; }
  }
</style>
