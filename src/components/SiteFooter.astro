---
import { site } from '../data/site';
import { url } from '../lib/url';
import Lockup from './Lockup.astro';
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <a class="footer-wordmark" href={url('/')} aria-label="Inventatory home"><Lockup tone="flat" shadow={false} /></a>
      <p class="byline">by <a href="https://github.com/Kwiatens">Kwiatens</a></p>
    </div>
    <nav aria-label="Footer links">
      <a href={url('/docs/')}>Documentation</a>
      <a href={url('/docs/resources/')}>Contribute</a>
      <a href={site.repository}>GitHub</a>
      <a href={site.repository + '/issues'}>Report an issue</a>
      <a href={site.repository + '/blob/main/LICENSE.md'}>GPL-3.0-only</a>
    </nav>
  </div>
</footer>
<style>
  .site-footer { margin-top: var(--space-8); border-top: var(--border) solid var(--divider); }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6) var(--space-8);
    padding-block: var(--space-10);
  }
  .footer-wordmark { display: block; width: 9rem; --lockup-word: var(--text); --lockup-mark: var(--text); }
  .byline { margin-top: var(--space-3); color: var(--muted); font: var(--text-xs)/1.5 var(--font-mono); }
  .byline a { color: var(--secondary); text-decoration: none; }
  .byline a:hover { color: var(--text); }
  nav { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); font: var(--text-sm)/1.5 var(--font-mono); }
  nav a { color: var(--secondary); text-decoration: none; }
  nav a:hover { color: var(--text); text-decoration: underline; text-underline-offset: .25em; }
</style>
