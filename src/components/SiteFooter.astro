---
import { site } from '../data/site';
import { url } from '../lib/url';
import Lockup from './Lockup.astro';
---
<footer class="wrap site-footer">
  <div class="footer-signature">
    <div class="footer-wordmark"><Lockup theme="gray" shadow /></div>
  </div>
  <nav aria-label="Footer links">
    <a href={url('/docs/resources/')}>Contribute</a>
    <a href={site.repository + '/issues'}>Report an issue</a>
    <a href={site.repository + '/blob/main/LICENSE.md'}>GPL-3.0-only</a>
  </nav>
</footer>
<style>
  .site-footer {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-12);
    border-top: var(--border) solid var(--divider);
    font: var(--text-xs)/1.7 var(--font-mono);
  }
  .footer-wordmark {
    width: min(100%, clamp(20rem, 32vw, 26rem));
    display: block;
  }
  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-6); }
  nav a { color: var(--muted); text-decoration: none; transition: color 180ms ease; }
  nav a:hover { color: var(--focus); }
  @media (max-width: 48rem) {
    .site-footer { flex-direction: column; align-items: flex-start; gap: var(--space-6); padding-block: var(--space-8); }
    nav { justify-content: flex-start; gap: var(--space-4); }
  }
</style>
